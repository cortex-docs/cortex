{
  "name": "@cortex-docs/docs-ui",
  "version": "0.1.5",
  "description": "Documentation runtime for Cortex Docs projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-docs/cortex.git",
    "directory": "packages/docs-ui"
  },
  "homepage": "https://github.com/cortex-docs/cortex#readme",
  "bugs": {
    "url": "https://github.com/cortex-docs/cortex/issues"
  },
  "keywords": [
    "cortex-docs",
    "api-documentation",
    "openapi",
    "mcp"
  ],
  "files": [
    "app",
    "components",
    "hooks",
    "lib",
    "public",
    "scripts",
    "next.config.js",
    "next-env.d.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev --port 3012",
    "build": "node scripts/build.mjs",
    "demo:build": "node scripts/cloudflare.mjs build",
    "demo:preview": "node scripts/cloudflare.mjs preview",
    "demo:deploy": "node scripts/cloudflare.mjs deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "next start",
    "clean": "rm -rf .next .next-build .open-next .cortex-demo"
  },
