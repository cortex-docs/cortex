// @ts-nocheck — generated MCP server, runtime-validated by Zod
import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
import { z } from 'zod';
import * as fs from 'node:fs';
import * as path from 'node:path';
import {
<% for (const tool of it.tools) { %>
  handle_<%= tool.name %>,
<% } %>
} from './handlers';

const BASE_URL = '<%= it.baseUrl %>';

export function createServer(baseUrl: string = BASE_URL): McpServer {
  const server = new McpServer({
    name: '<%= it.serverName %>',
    version: '<%= it.version %>',
  }, { instructions: <%= JSON.stringify(it.instructions) %> });

  // --- API Spec Resources (readable by AI agents) ---
<% for (const resource of it.specResources) { %>
  server.resource(
    '<%= resource.name %>',
    '<%= resource.uri %>',
    { description: '<%= it.esc(resource.description) %>', mimeType: '<%= resource.mimeType %>' },
    async () => ({
      contents: [{ uri: '<%= resource.uri %>', text: fs.readFileSync(path.resolve(__dirname, '../specs/<%= resource.fileName %>'), 'utf-8'), mimeType: '<%= resource.mimeType %>' }],
    }),
  );
<% } %>

  // --- Tools ---
<% for (const tool of it.staticTools) { %>
  server.tool(
    '<%= tool.name %>',
    '<%= it.esc(tool.description) %>',
    {},
    async () => ({ content: [{ type: 'text' as const, text: <%= JSON.stringify(tool.content) %> }] }),
  );

<% } %>
<% for (const tool of it.tools) { %>
  server.tool(
    '<%= tool.name %>',
    '<%= it.esc(tool.description) %>',
    {
<% for (const [paramName, param] of Object.entries(tool.inputSchema.properties)) { %>
      <%= paramName %>: <%= it.zodType(param.type, tool.inputSchema.required.includes(paramName), param.description) %>,
<% } %>
    },
    async (params: any) => handle_<%= tool.name %>(params, baseUrl),
  );

<% } %>
  return server;
}
