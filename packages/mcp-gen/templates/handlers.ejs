async function apiRequest(
  baseUrl: string,
  method: string,
  path: string,
  params: Record<string, unknown>,
  pathParams: string[],
  queryParams: string[],
): Promise<{ content: Array<{ type: 'text'; text: string }> }> {
  let resolvedPath = path;
  for (const p of pathParams) {
    resolvedPath = resolvedPath.replace(`{${p}}`, String(params[p] ?? ''));
  }

  const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  const url = new URL(resolvedPath.replace(/^\/+/, ''), normalizedBaseUrl);
  for (const q of queryParams) {
    if (params[q] !== undefined) {
      url.searchParams.set(q, String(params[q]));
    }
  }

  const bodyParams = Object.fromEntries(
    Object.entries(params).filter(([k]) => !pathParams.includes(k) && !queryParams.includes(k)),
  );
  const hasBody = method !== 'GET' && method !== 'DELETE' && Object.keys(bodyParams).length > 0;

  const response = await fetch(url.toString(), {
    method,
    headers: { 'Content-Type': 'application/json' },
    body: hasBody ? JSON.stringify(bodyParams) : undefined,
  });

  const text = await response.text();

  if (!response.ok) {
    return { content: [{ type: 'text', text: `Error ${response.status}: ${text}` }] };
  }

  return { content: [{ type: 'text', text }] };
}

async function postJson(url: string, body: unknown) {
  const response = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const text = await response.text();
  if (!response.ok) {
    return { content: [{ type: 'text' as const, text: `Error ${response.status}: ${text}` }] };
  }
  return { content: [{ type: 'text' as const, text }] };
}

<% for (const tool of it.tools) { %>
<% if (tool.source === 'websocket' && tool.name.startsWith('ws_describe_')) { %>
export async function handle_<%= tool.name %>(
  params: Record<string, unknown>,
  baseUrl: string,
) {
  return {
    content: [{ type: 'text' as const, text: JSON.stringify({
      channel: '<%= it.esc(tool.channel?.name) %>',
      description: '<%= it.esc(tool.channel?.description) %>',
      subscribe: <%= tool.channel?.subscribe?.summary ? "'" + it.esc(tool.channel.subscribe.summary) + "'" : 'null' %>,
      publish: <%= tool.channel?.publish?.summary ? "'" + it.esc(tool.channel.publish.summary) + "'" : 'null' %>,
    }, null, 2) }],
  };
}

<% } else if (tool.source === 'websocket') { %>
export async function handle_<%= tool.name %>(
  params: Record<string, unknown>,
  baseUrl: string,
) {
  return {
    content: [{ type: 'text' as const, text: JSON.stringify({
      channel: '<%= it.esc(tool.channel?.name) %>',
      payload: params,
    }, null, 2) }],
  };
}

<% } else if (tool.source === 'graphql' && tool.graphqlOperation) { %>
export async function handle_<%= tool.name %>(
  params: Record<string, unknown>,
  baseUrl: string,
) {
  const variables = Object.fromEntries(Object.entries(params).filter(([key]) => key !== 'selection'));
  const definitions = '<%= tool.graphqlOperation.args.map(arg => '$' + arg.name + ': ' + arg.typeRaw).join(', ') %>';
  const argumentsText = '<%= tool.graphqlOperation.args.map(arg => arg.name + ': $' + arg.name).join(', ') %>';
  const selection = typeof params.selection === 'string' && params.selection.trim()
    ? ` { ${params.selection.trim()} }`
    : '';
  const operation = '<%= tool.operationType === 'mutation' ? 'mutation' : tool.operationType === 'subscription' ? 'subscription' : 'query' %>';
  const query = `${operation}${definitions ? ` CortexOperation(${definitions})` : ''} { <%= tool.graphqlOperation.name %>${argumentsText ? `(${argumentsText})` : ''}${selection} }`;
  return postJson('<%= it.esc(it.graphqlEndpoint) %>', { query, variables });
}

<% } else if (tool.source === 'openrpc' && tool.openRpcMethod) { %>
export async function handle_<%= tool.name %>(
  params: Record<string, unknown>,
  baseUrl: string,
) {
  return postJson('<%= it.esc(it.openRpcUrl) %>', {
    jsonrpc: '2.0',
    id: Date.now(),
    method: '<%= it.esc(tool.openRpcMethod.name) %>',
    params,
  });
}

<% } else if (tool.operation) { %>
export async function handle_<%= tool.name %>(
  params: Record<string, unknown>,
  baseUrl: string,
) {
  return apiRequest(baseUrl, '<%= tool.operation.method.toUpperCase() %>', '<%= tool.operation.path %>', params, [<%= tool.operation.parameters.filter(p => p.in === 'path').map(p => "'" + p.name + "'").join(', ') %>], [<%= tool.operation.parameters.filter(p => p.in === 'query').map(p => "'" + p.name + "'").join(', ') %>]);
}

<% } %>
<% } %>
