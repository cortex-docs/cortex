{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cortex-static-assets",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "static.cortexdocs.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "static",
    "html_handling": "none",
    "not_found_handling": "none",
  },
}
