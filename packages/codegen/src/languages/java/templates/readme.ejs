<% const baseUrl = it.spec.info.servers[0]?.url ?? 'http://localhost:3000'; -%>
<% const clientClass = it.clientClass; -%>
<% const pkgName = it.config.languageConfig.package_name; -%>
<% const pkg = it.config.languageConfig.package_name.replace(/-/g, '.').toLowerCase(); -%>
<% const hasWs = it.config.config.sources.some(s => s.type === 'asyncapi-spec'); -%>
<% const hasGql = it.config.config.sources.some(s => s.type === 'graphql-spec'); -%>
<% const hasGrpc = it.config.config.sources.some(s => s.type === 'grpc-spec'); -%>
<% const version = it.spec.info.version; -%>
<%
// ── REST type helpers ──
const schemaMap = new Map(it.schemas.map(s => [s.className, s]));
const extractBase = (t) => t.replace(/\[\]$/, '').replace(/^List<(.+)>$/i, '$1').replace(/^Optional<(.+)>$/i, '$1').trim();
const isArr = (t) => t.endsWith('[]') || t.startsWith('List<');
const primitives = new Set(['String', 'int', 'long', 'double', 'boolean', 'void', 'Object', 'Map<String, Object>']);
const lnkRest = (t) => {
  if (!t || primitives.has(t)) return `\`${t}\``;
  const b = extractBase(t);
  if (schemaMap.has(b)) return `[\`${t}\`](#${b.toLowerCase()})`;
  return `\`${t}\``;
};

// ── GraphQL type helpers ──
const gqlTypeMap = it.gql ? new Map([...it.gql.types.map(t => [t.name, t]), ...it.gql.inputs.map(i => [i.name, i])]) : new Map();
const gqlEnumSet = it.gql ? new Set(it.gql.enums.map(e => e.name)) : new Set();
const gqlInputSet = it.gql ? new Set(it.gql.inputs.map(i => i.name)) : new Set();
const gqlScalars = new Set(['ID', 'String', 'Int', 'Float', 'Boolean']);
const extractGqlBase = (t) => t.replace(/[\[\]!]/g, '').trim();
const isGqlList = (t) => t.includes('[');
const lnkGql = (t) => {
  const b = extractGqlBase(t);
  if (gqlScalars.has(b)) return `\`${t}\``;
  if (gqlEnumSet.has(b)) return `[\`${t}\`](#${b.toLowerCase()}-enum)`;
  if (gqlInputSet.has(b)) return `[\`${t}\`](#${b.toLowerCase()}-input)`;
  if (gqlTypeMap.has(b)) return `[\`${t}\`](#${b.toLowerCase()})`;
  return `\`${t}\``;
};

// ── gRPC type helpers ──
const grpcMsgMap = it.grpcTypes ? new Map(it.grpcTypes.messages.map(m => [m.name, m])) : new Map();
const grpcEnumSet = it.grpcTypes ? new Set(it.grpcTypes.enums.map(e => e.name)) : new Set();
const grpcScalars = new Set(['string', 'bytes', 'bool', 'int32', 'int64', 'uint32', 'uint64', 'sint32', 'sint64', 'fixed32', 'fixed64', 'sfixed32', 'sfixed64', 'float', 'double']);
const lnkGrpc = (t) => {
  if (grpcScalars.has(t)) return `\`${t}\``;
  if (grpcMsgMap.has(t)) return `[\`${t}\`](#${t.toLowerCase()})`;
  if (grpcEnumSet.has(t)) return `[\`${t}\`](#${t.toLowerCase()}-enum)`;
  return `\`${t}\``;
};
