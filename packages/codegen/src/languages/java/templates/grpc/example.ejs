<% const method = it.method; -%>
<% const serviceName = it.service.serviceName; -%>
<% const clientVar = serviceName.charAt(0).toLowerCase() + serviceName.slice(1).replace(/Service$/, '') + 'Client'; -%>
<% const methodCall = method.methodName.charAt(0).toLowerCase() + method.methodName.slice(1); -%>
<% const requestType = method.inputType ?? (method.methodName + 'Request'); -%>
<% const fields = (method.inputFields ?? []).map(f => `.${f.name}(${f.type === 'number' || f.type === 'integer' ? '0' : '"value"'})`); -%>
<% const argsChain = fields.length > 0 ? fields.join('') : ''; -%>
<% if (method.serverStreaming) { -%>
var stream = <%= clientVar %>.<%= methodCall %>(new <%= requestType %>()<%= argsChain %>);
for (var item : stream) {
    System.out.println(item);
}
<% } else if (method.clientStreaming) { -%>
var stream = <%= clientVar %>.<%= methodCall %>();
stream.send(new <%= requestType %>()<%= argsChain %>);
var result = stream.close();
<% } else { -%>
var result = <%= clientVar %>.<%= methodCall %>(new <%= requestType %>()<%= argsChain %>);
<% } -%>
