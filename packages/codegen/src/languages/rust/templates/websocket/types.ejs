use serde::{Deserialize, Serialize};

<% for (const schema of it.schemas) { %>
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct <%= schema.className %> {
<% for (const prop of schema.properties) { %>
<% if (prop.name !== prop.originalName) { %>
    #[serde(rename = "<%= prop.originalName %>")]
<% } %>
<% if (!prop.required) { %>
    #[serde(skip_serializing_if = "Option::is_none")]
    pub <%= prop.name %>: Option<<%= prop.type %>>,
<% } else { %>
    pub <%= prop.name %>: <%= prop.type %>,
<% } %>
<% } %>
}

<% } %>
<% for (const ch of it.channels) { %>
<% if (ch.subscribeSchema && ch.subscribeSchema.properties.length > 0) { %>
/// Message received from the <%= ch.name %> channel.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct <%= ch.className %>Message {
<% for (const prop of ch.subscribeSchema.properties) { %>
<% if (prop.name !== prop.originalName) { %>
    #[serde(rename = "<%= prop.originalName %>")]
<% } %>
<% if (!prop.required) { %>
    #[serde(skip_serializing_if = "Option::is_none")]
    pub <%= prop.name %>: Option<<%= prop.type %>>,
<% } else { %>
    pub <%= prop.name %>: <%= prop.type %>,
<% } %>
<% } %>
}

<% } %>
<% if (ch.publishSchema && ch.publishSchema.properties.length > 0) { %>
/// Payload to publish to the <%= ch.name %> channel.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct <%= ch.className %>Payload {
<% for (const prop of ch.publishSchema.properties) { %>
<% if (prop.name !== prop.originalName) { %>
    #[serde(rename = "<%= prop.originalName %>")]
<% } %>
<% if (!prop.required) { %>
    #[serde(skip_serializing_if = "Option::is_none")]
    pub <%= prop.name %>: Option<<%= prop.type %>>,
<% } else { %>
    pub <%= prop.name %>: <%= prop.type %>,
<% } %>
<% } %>
}

<% } %>
<% } %>
