use reqwest::Client as HttpClient;
use serde::de::DeserializeOwned;
use serde::{Deserialize, Serialize};
use serde_json::Value;
use std::collections::HashMap;
use std::sync::Arc;
use std::time::Duration;
use tokio::time::Instant;
use tokio::sync::Mutex;
use futures_util::{SinkExt, StreamExt};
use tokio_tungstenite::tungstenite::Message;

use crate::gql_query_builder::*;

#[derive(Debug, Serialize)]
struct GqlRequest {
    query: String,
    #[serde(skip_serializing_if = "Option::is_none")]
    variables: Option<Value>,
}

#[derive(Debug, Deserialize)]
struct GqlResponse<T> {
    data: Option<T>,
    errors: Option<Vec<GqlErrorDetail>>,
}

#[derive(Debug, Deserialize, Clone)]
pub struct GqlErrorDetail {
    pub message: String,
}

#[derive(Debug, thiserror::Error)]
pub enum GqlError {
    #[error("GraphQL error: {0}")]
    Gql(String),
    #[error("Request error: {0}")]
    Request(#[from] reqwest::Error),
    #[error("JSON error: {0}")]
    Json(#[from] serde_json::Error),
    #[error("WebSocket error: {0}")]
    WebSocket(String),
}

pub struct SubscriptionHandle {
    cancel: tokio::sync::oneshot::Sender<()>,
}

impl SubscriptionHandle {
    pub fn unsubscribe(self) {
        let _ = self.cancel.send(());
    }
}

pub struct <%= it.clientClass %> {
    endpoint: String,
    ws_endpoint: String,
    http: HttpClient,
    headers: HashMap<String, String>,
    reconnect: bool,
    reconnect_interval: Duration,
    max_reconnect_attempts: u32,
    heartbeat_interval: Duration,
    heartbeat_timeout: Duration,
}

impl <%= it.clientClass %> {
    pub fn new(endpoint: &str) -> Self {
        Self::new_with_timeout(endpoint, Duration::from_secs(15))
    }

    pub fn new_with_timeout(endpoint: &str, timeout: Duration) -> Self {
        Self::new_with_options(
            endpoint, timeout, true, Duration::from_secs(3), 10,
            Duration::from_secs(30), Duration::from_secs(10),
        )
    }

    pub fn new_with_options(
        endpoint: &str,
        timeout: Duration,
        reconnect: bool,
        reconnect_interval: Duration,
        max_reconnect_attempts: u32,
        heartbeat_interval: Duration,
        heartbeat_timeout: Duration,
    ) -> Self {
        let ws_endpoint = endpoint.replacen("http", "ws", 1);
        let http = HttpClient::builder()
            .timeout(timeout)
            .build()
            .expect("Failed to build HTTP client");

        let mut headers = HashMap::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());

        Self {
            endpoint: endpoint.to_string(), ws_endpoint, http, headers,
            reconnect, reconnect_interval, max_reconnect_attempts,
            heartbeat_interval, heartbeat_timeout,
        }
    }

    pub fn default() -> Self {
        Self::new("<%= it.endpoint %>")
    }

    pub fn with_ws_endpoint(mut self, ws_endpoint: &str) -> Self {
        self.ws_endpoint = ws_endpoint.to_string();
        self
    }

    pub fn with_bearer_token(mut self, token: &str) -> Self {
        self.headers.insert("Authorization".to_string(), format!("Bearer {}", token));
        self
    }

    pub fn with_header(mut self, key: &str, value: &str) -> Self {
        self.headers.insert(key.to_string(), value.to_string());
        self
    }

    async fn execute<T: DeserializeOwned>(&self, query: &str, variables: Option<Value>) -> Result<T, GqlError> {
        let request_body = GqlRequest { query: query.to_string(), variables };

        let mut req = self.http.post(&self.endpoint);
        for (k, v) in &self.headers {
            req = req.header(k.as_str(), v.as_str());
        }

        let response = req.json(&request_body).send().await?;
        let body: GqlResponse<T> = response.json().await?;

        if let Some(errors) = &body.errors {
            if !errors.is_empty() {
                let messages: Vec<String> = errors.iter().map(|e| e.message.clone()).collect();
                return Err(GqlError::Gql(messages.join("; ")));
            }
        }

        body.data.ok_or_else(|| GqlError::Gql("No data in response".to_string()))
    }
<% if (it.queries.length > 0) { %>
    pub async fn query<T: DeserializeOwned>(&self, f: impl FnOnce(QueryBuilder) -> QueryBuilder) -> Result<T, GqlError> {
        let builder = f(QueryBuilder::new());
        let (query, variables) = builder.build_document();
        self.execute(&query, Some(variables)).await
    }
