<% if (it.subscriptions.length > 0) { %>
    pub fn subscribe<F: Fn(Value) + Send + 'static>(
        &self,
        f: impl FnOnce(SubscriptionBuilder) -> SubscriptionBuilder,
        on_data: F,
    ) -> SubscriptionHandle {
        let builder = f(SubscriptionBuilder::new());
        let (query, variables) = builder.build_document();
        let ws_url = self.ws_endpoint.clone();

        let (cancel_tx, mut cancel_rx) = tokio::sync::oneshot::channel::<()>();

        tokio::spawn(async move {
            let mut request = tokio_tungstenite::tungstenite::client::IntoClientRequest::into_client_request(ws_url.as_str()).unwrap();
            request.headers_mut().insert("Sec-WebSocket-Protocol", "graphql-transport-ws".parse().unwrap());

            let (ws_stream, _) = tokio_tungstenite::connect_async_with_config(
                request, None, false,
            ).await.expect("ws connect failed");

            let (mut write, mut read) = ws_stream.split();

            // graphql-ws protocol: connection_init
            write.send(Message::Text(
                serde_json::json!({"type": "connection_init"}).to_string().into()
            )).await.ok();

            // Wait for connection_ack
            while let Some(Ok(msg)) = read.next().await {
                if let Message::Text(txt) = msg {
                    let parsed: Value = serde_json::from_str(&txt).unwrap_or_default();
                    if parsed["type"].as_str() == Some("connection_ack") {
                        break;
                    }
                }
            }

            // Send subscribe
            let sub_msg = serde_json::json!({
                "id": "1",
                "type": "subscribe",
                "payload": { "query": query, "variables": variables }
            });
            write.send(Message::Text(sub_msg.to_string().into())).await.ok();

            // Read events until cancelled
            loop {
                tokio::select! {
                    msg = read.next() => {
                        match msg {
                            Some(Ok(Message::Text(txt))) => {
                                let parsed: Value = serde_json::from_str(&txt).unwrap_or_default();
                                if parsed["type"].as_str() == Some("next") {
                                    if let Some(data) = parsed.get("payload").and_then(|p| p.get("data")) {
                                        on_data(data.clone());
                                    }
                                } else if parsed["type"].as_str() == Some("complete") {
                                    break;
                                }
                            }
                            None => break,
                            _ => {}
                        }
                    }
                    _ = &mut cancel_rx => {
                        write.send(Message::Text(
                            serde_json::json!({"id": "1", "type": "complete"}).to_string().into()
                        )).await.ok();
                        break;
                    }
                }
            }
        });

        SubscriptionHandle { cancel: cancel_tx }
    }
<% } -%>
}
