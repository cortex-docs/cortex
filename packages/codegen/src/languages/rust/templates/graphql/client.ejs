<% if (it.subscriptions.length > 0) { %>
    pub fn subscribe<F: Fn(Value) + Send + 'static>(
        &self,
        f: impl FnOnce(SubscriptionBuilder) -> SubscriptionBuilder,
        on_data: F,
    ) -> SubscriptionHandle {
        let builder = f(SubscriptionBuilder::new());
        let (query, variables) = builder.build_document();
        let ws_url = self.ws_endpoint.clone();
        let reconnect = self.reconnect;
        let reconnect_interval = self.reconnect_interval;
        let max_reconnect_attempts = self.max_reconnect_attempts;
        let heartbeat_interval = self.heartbeat_interval;
        let heartbeat_timeout = self.heartbeat_timeout;

        let (cancel_tx, mut cancel_rx) = tokio::sync::oneshot::channel::<()>();

        tokio::spawn(async move {
            let mut attempts = 0u32;
            'connection: loop {
                if attempts > 0 { tokio::time::sleep(reconnect_interval).await; }
                let mut request = match tokio_tungstenite::tungstenite::client::IntoClientRequest::into_client_request(ws_url.as_str()) {
                    Ok(request) => request,
                    Err(_) => return,
                };
                request.headers_mut().insert("Sec-WebSocket-Protocol", "graphql-transport-ws".parse().unwrap());
                let ws_stream = match tokio_tungstenite::connect_async_with_config(request, None, false).await {
                    Ok((stream, _)) => stream,
                    Err(_) if reconnect && attempts < max_reconnect_attempts => { attempts += 1; continue; }
                    Err(_) => return,
                };
                let (mut write, mut read) = ws_stream.split();
                if write.send(Message::Text(serde_json::json!({"type": "connection_init"}).to_string().into())).await.is_err() {
                    if reconnect && attempts < max_reconnect_attempts { attempts += 1; continue; }
                    return;
                }
                let acknowledged = loop {
                    tokio::select! {
                        msg = read.next() => match msg {
                            Some(Ok(Message::Text(text))) => {
                                let parsed: Value = serde_json::from_str(&text).unwrap_or_default();
                                if parsed["type"].as_str() == Some("connection_ack") { break true; }
                            }
                            _ => break false,
                        },
                        _ = &mut cancel_rx => return,
                    }
                };
                if !acknowledged {
                    if reconnect && attempts < max_reconnect_attempts { attempts += 1; continue; }
                    return;
                }
                let subscribe = serde_json::json!({
                    "id": "1", "type": "subscribe",
                    "payload": { "query": query, "variables": variables }
                });
                if write.send(Message::Text(subscribe.to_string().into())).await.is_err() {
                    if reconnect && attempts < max_reconnect_attempts { attempts += 1; continue; }
                    return;
                }
                attempts = 0;
                let heartbeat_period = if heartbeat_interval.is_zero() { Duration::from_secs(31_536_000) } else { heartbeat_interval };
                let mut heartbeat = tokio::time::interval(heartbeat_period);
                heartbeat.tick().await;
                let mut last_activity = Instant::now();
                loop {
                    tokio::select! {
                        msg = read.next() => match msg {
                            Some(Ok(Message::Text(text))) => {
                                last_activity = Instant::now();
                                let parsed: Value = serde_json::from_str(&text).unwrap_or_default();
                                match parsed["type"].as_str() {
                                    Some("next") => if let Some(data) = parsed.get("payload").and_then(|p| p.get("data")) { on_data(data.clone()); },
                                    Some("ping") => { let _ = write.send(Message::Text(serde_json::json!({"type": "pong"}).to_string().into())).await; },
                                    Some("complete") | Some("error") => return,
                                    _ => {}
                                }
                            }
                            Some(Ok(_)) => { last_activity = Instant::now(); }
                            _ => break,
                        },
                        _ = heartbeat.tick() => {
                            if !heartbeat_interval.is_zero() {
                                if !heartbeat_timeout.is_zero() && last_activity.elapsed() > heartbeat_interval + heartbeat_timeout { break; }
                                let _ = write.send(Message::Text(serde_json::json!({"type": "ping"}).to_string().into())).await;
                            }
                        },
                        _ = &mut cancel_rx => {
                            let _ = write.send(Message::Text(serde_json::json!({"id": "1", "type": "complete"}).to_string().into())).await;
                            return;
                        }
                    }
                }
                if !reconnect || attempts >= max_reconnect_attempts { break 'connection; }
                attempts += 1;
            }
        });

        SubscriptionHandle { cancel: cancel_tx }
    }
<% } -%>
