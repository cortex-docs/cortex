<% if (it.mutations.length > 0) { %>
    pub async fn mutate<T: DeserializeOwned>(&self, f: impl FnOnce(MutationBuilder) -> MutationBuilder) -> Result<T, GqlError> {
        let builder = f(MutationBuilder::new());
        let (query, variables) = builder.build_document();
        self.execute(&query, Some(variables)).await
    }
