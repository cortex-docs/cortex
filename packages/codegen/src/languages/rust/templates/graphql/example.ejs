<% const opType = it.opType ?? 'query'; -%>
<% const op = it.op; -%>
<% const opName = op?.name ?? it.opName ?? 'items'; -%>
<% const args = op?.args ?? it.args ?? []; -%>
<% const exVal = (a) => { if (['Int', 'Float', 'number', 'integer'].includes(a.type)) return 'Some(10)'; if (['Boolean', 'boolean'].includes(a.type)) return 'Some(true)'; if (a.type === 'ID') return `"example_${a.name}".into()`; return `"value".into()`; }; -%>
<% const argsStr = (typeof args === 'string') ? args : (args.length > 0 ? `${it.utils.toPascalCase(opName)}QueryVariables { ${args.map(a => `${a.name}: ${exVal(a)}`).join(', ')} }` : `${it.utils.toPascalCase(opName)}QueryVariables::default()`); -%>
<% if (opType === 'query') { -%>
// Query <%= opName %>
let result = gql.query(|q|
    q.<%= opName %>(<%= argsStr %>, |p|
        p.id().name()
    )
).await?;
<% } else if (opType === 'mutation') { -%>
// Mutate <%= opName %>
let result = gql.mutate(|m|
    m.<%= opName %>(<%= argsStr %>, |p|
        p.id().name()
    )
).await?;
<% } else { -%>
// One-shot subscription (resolves on first event)
let event = gql.subscribe_once(|s|
    s.<%= opName %>(<%= argsStr %>, |p|
        p.id().name()
    )
).await?;

// Continuous subscription
let unsubscribe = gql.subscribe(
    |s| s.<%= opName %>(|p| p.id().name()),
    |data| println!("Event: {:?}", data),
).await;
// Later: unsubscribe();
<% } -%>
