<% const crateName = it.utils.toSnakeCase(it.config.languageConfig.package_name); -%>
<% const baseUrl = it.spec.info.servers[0]?.url ?? 'http://localhost:3000'; -%>
<% const op = it.op; -%>
<% const resource = it.resource; -%>
// <%= op.summary || op.name %>
<% if (op.method === 'DELETE' && op.responseType === 'void') { -%>
client.<%= it.utils.toSnakeCase(resource.name) %>.<%= op.name %>(&client, <%= op.pathParams.map(p => `"example-${p.originalName}"`).join(', ') %>).await?;
<% } else if (op.method === 'GET' && op.pathParams.length === 0) { -%>
let <%= it.utils.toSnakeCase(resource.name) %> = client.<%= it.utils.toSnakeCase(resource.name) %>.<%= op.name %>(&client, <% if (op.queryParams.length > 0) { %><%= op.queryParams.map(q => `${q.type === 'i64' || q.type === 'i32' || q.type === 'f64' ? 'Some(10)' : 'None'}`).join(', ') %><% } else { %>None, None<% } %>).await?;
<% } else if (op.method === 'GET' && op.pathParams.length > 0) { -%>
let <%= it.utils.toSnakeCase(it.utils.singularize(resource.name)) %> = client.<%= it.utils.toSnakeCase(resource.name) %>.<%= op.name %>(&client, <%= op.pathParams.map(p => `"example-${p.originalName}"`).join(', ') %>).await?;
<% } else if (op.hasBody && op.pathParams.length === 0) { -%>
let created = client.<%= it.utils.toSnakeCase(resource.name) %>.<%= op.name %>(&client, &<%= op.bodyType %> {
<% const bodySchema = it.schemas.find(s => s.className === op.bodyType); -%>
<% if (bodySchema) { for (const prop of bodySchema.properties.filter(p => p.required)) { -%>
    <%= it.utils.toSnakeCase(prop.name) %>: <%= prop.type === 'String' || prop.type === 'string' ? `"value".into()` : prop.type === 'i64' || prop.type === 'i32' || prop.type === 'f64' ? '0' : `"value".into()` %>,
<% } -%>
<% for (const prop of bodySchema.properties.filter(p => !p.required)) { -%>
    <%= it.utils.toSnakeCase(prop.name) %>: None,
<% } -%>
<% } else { -%>
    // <%= op.bodyType %> fields
<% } -%>
}).await?;
<% } else if (op.hasBody && op.pathParams.length > 0) { -%>
let updated = client.<%= it.utils.toSnakeCase(resource.name) %>.<%= op.name %>(&client, <%= op.pathParams.map(p => `"example-${p.originalName}"`).join(', ') %>, &<%= op.bodyType %> {
<% const updBodySchema = it.schemas.find(s => s.className === op.bodyType); -%>
<% if (updBodySchema) { for (const prop of updBodySchema.properties.filter(p => p.required)) { -%>
    <%= it.utils.toSnakeCase(prop.name) %>: <%= prop.type === 'String' || prop.type === 'string' ? `"value".into()` : prop.type === 'i64' || prop.type === 'i32' || prop.type === 'f64' ? '0' : `"value".into()` %>,
<% } -%>
<% for (const prop of updBodySchema.properties.filter(p => !p.required)) { -%>
    <%= it.utils.toSnakeCase(prop.name) %>: None,
<% } -%>
<% } else { -%>
    // <%= op.bodyType %> fields
<% } -%>
}).await?;
<% } -%>
