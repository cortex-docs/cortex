use serde::{Deserialize, Serialize};

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ListResponse<T> {
    pub data: Vec<T>,
    #[serde(skip_serializing_if = "Option::is_none")]
    pub next_cursor: Option<String>,
}

<% for (const schema of it.schemas) { %>
<% if (schema.isEnum) { %>
#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
pub enum <%= schema.className %> {
<% for (const v of schema.enumValues) { %>
    #[serde(rename = "<%= v %>")]
    <%= it.naming.enumValue(String(v)) %>,
<% } %>
}

<% } else { %>
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct <%= schema.className %> {
<% for (const prop of schema.properties) { %>
<% if (prop.name !== prop.originalName) { %>
    #[serde(rename = "<%= prop.originalName %>")]
<% } %>
<% if (!prop.required) { %>
    #[serde(skip_serializing_if = "Option::is_none")]
    pub <%= prop.name %>: Option<<%= prop.type %>>,
<% } else { %>
    pub <%= prop.name %>: <%= prop.type %>,
<% } %>
<% } %>
}

<% } %>
<% } %>
