        &mut self,
        request: crate::grpc_types::<%= method.inputType %>,
    ) -> Result<GrpcResponse<crate::grpc_types::<%= method.outputType %>>, GrpcError> {
        let resp: crate::grpc_types::<%= method.outputType %> = grpc_post(
            &self.http,
            &self.base_url,
            "<%= service.name %>",
            "<%= method.name %>",
            &request,
        )
