        Ok(GrpcResponse::new(resp))
    }

<% } else if (!method.clientStreaming && method.serverStreaming) { %>
    /// Server-streaming RPC: <%= method.name %>.
    pub async fn <%= it.naming.propertyName(method.name) %>(
        &mut self,
        request: crate::grpc_types::<%= method.inputType %>,
    ) -> Result<GrpcResponse<GrpcStreaming<crate::grpc_types::<%= method.outputType %>>>, GrpcError> {
        let url = format!(
            "{}/grpc/<%= service.name %>/<%= method.name %>",
            self.base_url.trim_end_matches('/'),
        );
        let raw: serde_json::Value = self
            .http
            .post(&url)
            .header("Content-Type", "application/json")
            .json(&request)
            .send()
            .await?
            .json()
            .await?;
        let items_value = if let Some(arr) = raw.get("data") {
            arr.clone()
        } else {
            raw
        };
        let items: Vec<crate::grpc_types::<%= method.outputType %>> =
            serde_json::from_value(items_value)?;
        Ok(GrpcResponse::new(GrpcStreaming {
            items: items.into_iter(),
        }))
    }

