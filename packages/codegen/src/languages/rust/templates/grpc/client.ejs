use serde::de::DeserializeOwned;
use serde::Serialize;
use std::pin::Pin;
use std::task::{Context, Poll};

/// Error type for gRPC-over-HTTP calls.
#[derive(Debug, thiserror::Error)]
pub enum GrpcError {
    #[error("HTTP error: {0}")]
    Http(#[from] reqwest::Error),
    #[error("JSON error: {0}")]
    Json(#[from] serde_json::Error),
}

/// Wrapper around a gRPC response, providing `into_inner()`.
pub struct GrpcResponse<T> {
    inner: T,
}

impl<T> GrpcResponse<T> {
    pub fn new(inner: T) -> Self {
        Self { inner }
    }

    pub fn into_inner(self) -> T {
        self.inner
    }
}

/// A stream of items returned by a server-streaming RPC.
pub struct GrpcStreaming<T> {
    items: std::vec::IntoIter<T>,
}

impl<T: Unpin> futures_util::Stream for GrpcStreaming<T> {
    type Item = Result<T, GrpcError>;

    fn poll_next(mut self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
        Poll::Ready(self.items.next().map(Ok))
    }
}

async fn grpc_post<Req: Serialize, Resp: DeserializeOwned>(
    http: &reqwest::Client,
    base_url: &str,
    service: &str,
    method: &str,
    request: &Req,
) -> Result<Resp, GrpcError> {
    let url = format!("{}/grpc/{}/{}", base_url.trim_end_matches('/'), service, method);
    let resp = http
        .post(&url)
        .header("Content-Type", "application/json")
        .json(request)
        .send()
        .await?
        .json::<Resp>()
        .await?;
    Ok(resp)
}

