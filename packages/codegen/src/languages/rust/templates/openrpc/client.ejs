use reqwest::Client;
use serde::{Deserialize, Serialize};
use serde_json::{json, Value};
use std::collections::HashMap;
use std::sync::atomic::{AtomicI64, Ordering};

#[derive(Debug, Serialize)]
struct JsonRpcRequest {
    jsonrpc: String,
    method: String,
    #[serde(skip_serializing_if = "Option::is_none")]
    params: Option<Value>,
    id: i64,
}

#[derive(Debug, Deserialize)]
struct JsonRpcResponse {
    #[allow(dead_code)]
    jsonrpc: String,
    result: Option<Value>,
    error: Option<JsonRpcErrorData>,
    #[allow(dead_code)]
    id: i64,
}

#[derive(Debug, Deserialize)]
struct JsonRpcErrorData {
    code: i64,
    message: String,
    #[allow(dead_code)]
    data: Option<Value>,
}

#[derive(Debug, thiserror::Error)]
pub enum JsonRpcError {
    #[error("JSON-RPC error {code}: {message}")]
    Rpc { code: i64, message: String, data: Option<Value> },
    #[error("HTTP error: {0}")]
    Http(#[from] reqwest::Error),
}

pub struct <%= it.clientClass %> {
    url: String,
    client: Client,
    headers: HashMap<String, String>,
    id_counter: AtomicI64,
}

impl <%= it.clientClass %> {
    pub fn new(url: &str) -> Self {
        Self {
            url: url.to_string(),
            client: Client::new(),
            headers: HashMap::new(),
            id_counter: AtomicI64::new(0),
        }
    }

    pub fn set_header(&mut self, key: &str, value: &str) {
        self.headers.insert(key.to_string(), value.to_string());
    }

    async fn call(&self, method: &str, params: Option<Value>) -> Result<Value, JsonRpcError> {
        let id = self.id_counter.fetch_add(1, Ordering::SeqCst) + 1;
        let request = JsonRpcRequest {
            jsonrpc: "2.0".to_string(),
            method: method.to_string(),
            params,
            id,
        };

        let mut builder = self.client.post(&self.url)
            .header("Content-Type", "application/json")
            .json(&request);

        for (key, value) in &self.headers {
            builder = builder.header(key, value);
        }

        let response: JsonRpcResponse = builder.send().await?.json().await?;

        if let Some(error) = response.error {
            return Err(JsonRpcError::Rpc {
                code: error.code,
                message: error.message,
                data: error.data,
            });
        }

        Ok(response.result.unwrap_or(Value::Null))
    }

<% for (const method of it.methods) { -%>
<% const methodName = it.naming.methodName(method.name); -%>
<% const params = method.params ?? []; -%>
<% if (method.summary || method.description) { -%>
    /// <%= method.summary ?? method.description %>
<% } -%>
<% if (params.length > 0) { -%>
    pub async fn <%= methodName %>(&self, params: Value) -> Result<Value, JsonRpcError> {
        self.call("<%= method.name %>", Some(params)).await
    }
<% } else { -%>
    pub async fn <%= methodName %>(&self) -> Result<Value, JsonRpcError> {
        self.call("<%= method.name %>", None).await
    }
<% } -%>

<% } -%>
}
