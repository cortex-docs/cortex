<% const baseUrl = it.baseUrl ?? (it.spec.info.servers[0]?.url ?? 'http://localhost:3000'); -%>
<% const pkg = it.pkg ?? it.config.languageConfig.package_name.replace(/-/g, '.').toLowerCase(); -%>
<% const wsUrl = it.websocketUrl ?? baseUrl.replace(/^http/, 'ws').replace(/\/v\d+$/, '') + '/ws'; -%>
import <%= pkg %>.<%= it.clientClass %>

val ws = <%= it.clientClass %>(
    url = "<%= wsUrl %>"
)
