package <%= it.packageName.replace(/-/g, '.').toLowerCase() %>

import kotlinx.serialization.Serializable

<% for (const [name, schema] of Array.from(it.schemas.entries())) { -%>
<% const className = it.naming.className(name); -%>
<% if (schema.enum) { -%>

enum class <%= className %>(val value: String) {
<% for (let i = 0; i < schema.enum.length; i++) { -%>
    <%= it.naming.enumValue(schema.enum[i]) %>("<%= schema.enum[i] %>")<%= i < schema.enum.length - 1 ? ',' : ';' %>
<% } -%>
}

<% } else if (schema.type === 'object' && schema.properties) { -%>
<% if (schema.description) { -%>
/** <%= schema.description %> */
<% } -%>
@Serializable
data class <%= className %>(
<% const propEntries = Object.entries(schema.properties); -%>
<% const required = schema.required ?? []; -%>
<% for (let i = 0; i < propEntries.length; i++) { -%>
<% const [propName, propSchema] = propEntries[i]; -%>
<% const ktType = it.mapJsonSchemaType(propSchema); -%>
<% const isRequired = required.includes(propName); -%>
<% if (propSchema.description) { -%>
    /** <%= propSchema.description %> */
<% } -%>
    val <%= it.naming.propertyName(propName) %>: <%= isRequired ? ktType : ktType + '?' %><%= isRequired ? '' : ' = null' %><%= i < propEntries.length - 1 ? ',' : '' %>
<% } -%>
)

<% } -%>
<% } -%>
