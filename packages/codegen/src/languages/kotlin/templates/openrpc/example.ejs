<% const method = it.method; -%>
<% const callName = it.naming?.methodName?.(method.name) ?? method.methodName ?? method.name; -%>
<% const params = (method.params ?? []).map(p => `"${p.name}" to ${p.type === 'number' || p.type === 'integer' ? '0' : p.type === 'boolean' ? 'true' : '"value"'}`); -%>
<% if (params.length > 0) { -%>
val result = client.<%= callName %>(mapOf(
    <%= params.join(',\n    ') %>
))
<% } else { -%>
val result = client.<%= callName %>()
<% } -%>
println(result)
