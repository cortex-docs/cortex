<% const method = it.method; -%>
<% const serviceName = it.service.serviceName; -%>
<% const clientVar = it.service.clientVar ?? (serviceName.charAt(0).toLowerCase() + serviceName.slice(1).replace(/Service$/, '') + 'Client'); -%>
<% const methodCall = method.methodName.charAt(0).toLowerCase() + method.methodName.slice(1); -%>
<% const requestType = method.inputType ?? (method.methodName + 'Request'); -%>
<% const fields = (method.inputFields ?? []).map(f => `${f.name} = ${f.type === 'number' || f.type === 'integer' ? '0' : '"value"'}`); -%>
<% const argsStr = fields.length > 0 ? fields.join(', ') : ''; -%>
<% if (method.serverStreaming) { -%>
val stream = <%= clientVar %>.<%= methodCall %>(<%= requestType %>(<%= argsStr %>))
stream.forEach { item -> println("Item: $item") }
<% } else if (method.clientStreaming) { -%>
val stream = <%= clientVar %>.<%= methodCall %>()
stream.send(<%= requestType %>(<%= argsStr %>))
val result = stream.close()
<% } else { -%>
val result = <%= clientVar %>.<%= methodCall %>(<%= requestType %>(<%= argsStr %>))
<% } -%>
