using System.Net.Http;
using System.Net.Http.Json;
using System.Text;
using System.Text.Json;
using System.Text.Json.Nodes;

namespace <%= it.naming.className(it.packageName) %>;

public class JsonRpcError : Exception
{
    public int Code { get; }
    public string RpcMessage { get; }
    public JsonNode? Data { get; }

    public JsonRpcError(int code, string message, JsonNode? data = null)
        : base($"JSON-RPC error {code}: {message}")
    {
        Code = code;
        RpcMessage = message;
        Data = data;
    }
}

public class <%= it.clientClass %>
{
    private readonly string _url;
    private readonly HttpClient _httpClient;
    private readonly Dictionary<string, string> _headers;
    private long _idCounter;

    public <%= it.clientClass %>(string url = "<%= it.serverUrl %>", Dictionary<string, string>? headers = null)
    {
        _url = url;
        _httpClient = new HttpClient();
        _headers = headers ?? new Dictionary<string, string>();
    }

    public void SetHeader(string key, string value)
    {
        _headers[key] = value;
    }

    private async Task<JsonNode?> CallAsync(string method, JsonNode? parameters = null)
    {
        var id = Interlocked.Increment(ref _idCounter);
        var request = new JsonObject
        {
            ["jsonrpc"] = "2.0",
            ["method"] = method,
            ["id"] = id,
        };
        if (parameters != null)
        {
            request["params"] = parameters;
        }

        var content = new StringContent(request.ToJsonString(), Encoding.UTF8, "application/json");
        using var httpRequest = new HttpRequestMessage(HttpMethod.Post, _url) { Content = content };
        foreach (var (key, value) in _headers)
        {
            httpRequest.Headers.TryAddWithoutValidation(key, value);
        }

        var response = await _httpClient.SendAsync(httpRequest);
        var body = await response.Content.ReadAsStringAsync();
        var rpcResponse = JsonNode.Parse(body);

        var error = rpcResponse?["error"];
        if (error != null)
        {
            var code = error["code"]?.GetValue<int>() ?? -1;
            var message = error["message"]?.GetValue<string>() ?? "Unknown error";
            throw new JsonRpcError(code, message, error["data"]);
        }

        return rpcResponse?["result"];
    }

<% for (const method of it.methods) { -%>
<% const methodName = it.naming.methodName(method.name); -%>
<% const params = method.params ?? []; -%>
<% if (method.summary || method.description) { -%>
    /// <summary><%= method.summary ?? method.description %></summary>
<% } -%>
<% if (params.length > 0) { -%>
    public async Task<JsonNode?> <%= methodName %>Async(Dictionary<string, object?> parameters)
    {
        var jsonParams = new JsonObject();
        foreach (var (key, value) in parameters)
        {
            jsonParams[key] = JsonSerializer.SerializeToNode(value);
        }
        return await CallAsync("<%= method.name %>", jsonParams);
    }
<% } else { -%>
    public async Task<JsonNode?> <%= methodName %>Async()
    {
        return await CallAsync("<%= method.name %>");
    }
<% } -%>

<% } -%>
}
