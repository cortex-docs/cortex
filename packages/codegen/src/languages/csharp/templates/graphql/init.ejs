<% const ns = it.utils.toPascalCase(it.config.languageConfig.package_name); -%>
<% const baseUrl = it.spec.info.servers[0]?.url ?? 'http://localhost:3000'; -%>
<% const gqlEndpoint = it.graphqlEndpoint ?? baseUrl.replace(/\/v\d+$/, '') + '/graphql'; -%>
<% const wsEndpoint = it.graphqlWsEndpoint ?? gqlEndpoint.replace(/^http/, 'ws'); -%>
using <%= ns %>.Gql;

var gql = new <%= it.clientClass %>(
    endpoint: "<%= gqlEndpoint %>",
    wsEndpoint: "<%= wsEndpoint %>"
);
