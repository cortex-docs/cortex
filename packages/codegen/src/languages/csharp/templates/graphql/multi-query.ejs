<% const queries = (it.queries ?? []).slice(0, 2); -%>
<% const exVal = (a) => { if (['Int', 'Float', 'number', 'integer'].includes(a.type)) return '10'; if (['Boolean', 'boolean'].includes(a.type)) return 'true'; if (a.type === 'ID') return `"example_${a.name}"`; return '"value"'; }; -%>
// Multi-query: fetch multiple resources in one call
var multi = await gql.QueryAsync<dynamic>(q =>
    q
<% for (const query of queries) { -%>
<% const argsObj = query.args.length > 0 ? `new { ${query.args.map(a => `${a.name} = ${exVal(a)}`).join(', ')} }` : 'new {}'; -%>
        .<%= query.name %>(<%= argsObj %>, p => p.Id().Name())
<% } -%>
);
