<% const r = it.resource; %>
<% const clientClass = it.clientClass; %>
<% const schemaTypeNames = new Set(it.schemas.map(s => s.className)); %>
<% const toSdkType = (type) => type.replace(/\b[A-Z][A-Za-z0-9_]*\b/g, (name) => schemaTypeNames.has(name) || name === 'FileUpload' ? `Types.${name}` : name); %>
<% const queryKey = (name) => /^[A-Za-z_$][\w$]*$/.test(name) ? name : JSON.stringify(name); %>
import type { <%= clientClass %> } from '../client.js';
import type * as Types from '../types.js';

export class <%= r.className %> {
  constructor(private readonly client: <%= clientClass %>) {}

<% for (const op of r.operations) { %>
<% const lastRequiredQuery = op.queryParams.findLastIndex(p => p.required); %>
<% const queryParams = op.queryParams.map((p, index) => p.required ? `${p.name}: ${toSdkType(p.type)}` : index < lastRequiredQuery ? `${p.name}: ${toSdkType(p.type)} | undefined` : `${p.name}?: ${toSdkType(p.type)}`); %>
<% const params = [...op.pathParams.map(p => `${p.name}: ${toSdkType(p.type)}`), ...(op.hasBody ? [`body: ${toSdkType(op.bodyType)}`] : []), ...queryParams]; %>
<% let pathExpr = op.path; for (const p of op.pathParams) { pathExpr = pathExpr.replace(`{${p.originalName}}`, `\${${p.name}}`); } %>
<% if (op.summary) { %>
  /** <%= op.summary %> */
<% } %>
  async <%= op.name %>(<%= params.join(', ') %>): Promise<<%= toSdkType(op.responseType) %>> {
    return this.client.request<<%= toSdkType(op.responseType) %>>('<%= op.method %>', `<%= pathExpr %>`<% if (op.queryParams.length || op.hasBody) { %>, { <% if (op.queryParams.length) { %>query: { <%= op.queryParams.map(p => `${queryKey(p.originalName)}: ${p.name}`).join(', ') %> }<% } %><% if (op.hasBody) { %><% if (op.queryParams.length) { %>, <% } %>body<% if (op.isMultipart) { %>, multipart: true<% } %><% if (op.isRawBinary) { %>, rawFile: true, rawContentType: '<%= op.contentType %>'<% } %><% } %> }<% } %>);
  }

<% } %>
}
