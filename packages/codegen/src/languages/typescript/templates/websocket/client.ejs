import type * as Types from './ws-types.js';

type EventHandler = (...args: unknown[]) => void;

class EventEmitter {
  private _events = new Map<string, Set<EventHandler>>();
  on(event: string, handler: EventHandler): this { if (!this._events.has(event)) this._events.set(event, new Set()); this._events.get(event)!.add(handler); return this; }
  off(event: string, handler: EventHandler): this { this._events.get(event)?.delete(handler); return this; }
  emit(event: string, ...args: unknown[]): boolean { const handlers = this._events.get(event); if (!handlers) return false; for (const h of handlers) h(...args); return true; }
}

export interface <%= it.clientClass %>Options {
  url?: string;
  protocols?: string | string[];
  reconnect?: boolean;
  reconnectInterval?: number;
  maxReconnectAttempts?: number;
  /** Application heartbeat interval in milliseconds. Set to 0 to disable. */
  heartbeatInterval?: number;
  /** Time to wait for any server traffic after a heartbeat before reconnecting. */
  heartbeatTimeout?: number;
  heartbeatFormat?: 'json' | 'text';
  /** Client-initiated heartbeat payload. */
  heartbeatMessage?: unknown;
  /** Expected server response to a client-initiated heartbeat. */
  heartbeatExpectedResponseMessage?: unknown;
  /** Server-initiated heartbeat payload. */
  serverHeartbeatMessage?: unknown;
  /** Client response to a server-initiated heartbeat. */
  heartbeatResponseMessage?: unknown;
  headers?: Record<string, string>;
}

type MessageHandler<T = unknown> = (data: T) => void;

export class <%= it.clientClass %> extends EventEmitter {
  private ws: WebSocket | null = null;
  private url: string;
  private options: {
    reconnect: boolean;
    reconnectInterval: number;
    maxReconnectAttempts: number;
    heartbeatInterval: number;
    heartbeatTimeout: number;
    heartbeatFormat: 'json' | 'text';
    heartbeatMessage?: unknown;
    heartbeatExpectedResponseMessage?: unknown;
    serverHeartbeatMessage?: unknown;
    heartbeatResponseMessage?: unknown;
  };
  private protocols?: string | string[];
  private handlers = new Map<string, Set<MessageHandler>>();
  private reconnectAttempts = 0;
  private reconnectTimer: ReturnType<typeof setTimeout> | null = null;
  private heartbeatTimer: ReturnType<typeof setInterval> | null = null;
  private heartbeatDeadline: ReturnType<typeof setTimeout> | null = null;
  private manuallyClosed = false;

  constructor(options: <%= it.clientClass %>Options = {}) {
    super();
    this.url = options.url ?? '<%= it.serverUrl %>';
    this.protocols = options.protocols;
    this.options = {
      reconnect: options.reconnect ?? true,
      reconnectInterval: options.reconnectInterval ?? 3000,
      maxReconnectAttempts: options.maxReconnectAttempts ?? 10,
      heartbeatInterval: options.heartbeatInterval ?? <%= it.heartbeat.intervalMs %>,
      heartbeatTimeout: options.heartbeatTimeout ?? <%= it.heartbeat.timeoutMs %>,
      heartbeatFormat: options.heartbeatFormat ?? '<%= it.heartbeat.format %>',
      heartbeatMessage: options.heartbeatMessage ?? <% if (it.heartbeat.hasClientMessage) { %><% if (it.heartbeat.format === 'json') { %>JSON.parse(<%= it.heartbeat.clientMessageLiteral %>)<% } else { %><%= it.heartbeat.clientMessageLiteral %><% } %><% } else { %>undefined<% } %>,
      heartbeatExpectedResponseMessage: options.heartbeatExpectedResponseMessage ?? <% if (it.heartbeat.hasClientResponse) { %><% if (it.heartbeat.format === 'json') { %>JSON.parse(<%= it.heartbeat.clientResponseLiteral %>)<% } else { %><%= it.heartbeat.clientResponseLiteral %><% } %><% } else { %>undefined<% } %>,
      serverHeartbeatMessage: options.serverHeartbeatMessage ?? <% if (it.heartbeat.hasServerMessage) { %><% if (it.heartbeat.format === 'json') { %>JSON.parse(<%= it.heartbeat.serverMessageLiteral %>)<% } else { %><%= it.heartbeat.serverMessageLiteral %><% } %><% } else { %>undefined<% } %>,
      heartbeatResponseMessage: options.heartbeatResponseMessage ?? <% if (it.heartbeat.hasServerResponse) { %><% if (it.heartbeat.format === 'json') { %>JSON.parse(<%= it.heartbeat.serverResponseLiteral %>)<% } else { %><%= it.heartbeat.serverResponseLiteral %><% } %><% } else { %>undefined<% } %>,
    };
  }

  connect(): Promise<void> {
    this.manuallyClosed = false;
    if (this.reconnectTimer) {
      clearTimeout(this.reconnectTimer);
      this.reconnectTimer = null;
    }
    return new Promise((resolve, reject) => {
      this.ws = new WebSocket(this.url, this.protocols);

      this.ws.onopen = () => {
        this.reconnectAttempts = 0;
        this.startHeartbeat();
        this.emit('connected');
        resolve();
      };

      this.ws.onmessage = (event) => {
        const raw = typeof event.data === 'string' ? event.data : new TextDecoder().decode(event.data as ArrayBuffer);
        let data: unknown = raw;
        try { data = JSON.parse(raw); } catch { /* Text heartbeat or non-JSON application message. */ }

        if (this.heartbeatMatches(raw, data, this.options.serverHeartbeatMessage)) {
          this.acknowledgeHeartbeat();
          if (this.options.heartbeatResponseMessage !== undefined) {
            this.ws?.send(this.encodeHeartbeat(this.options.heartbeatResponseMessage));
          }
          return;
        }
        if (this.options.heartbeatExpectedResponseMessage === undefined) {
          this.acknowledgeHeartbeat();
        } else if (this.heartbeatMatches(raw, data, this.options.heartbeatExpectedResponseMessage)) {
          this.acknowledgeHeartbeat();
          return;
        }

        try {
          if (!data || typeof data !== 'object') throw new Error('Non-JSON message');
          const message = data as Record<string, unknown>;
          const channel = String(message.channel ?? message.type ?? message.event ?? '');
          this.emit('message', message);
          if (channel && this.handlers.has(channel)) {
            for (const handler of this.handlers.get(channel)!) {
              handler(message.payload ?? message.data ?? message);
            }
          }
        } catch {
          this.emit('message', event.data);
        }
      };

      this.ws.onclose = (event) => {
        this.stopHeartbeat();
        this.ws = null;
        this.emit('disconnected', { code: event.code, reason: event.reason });
        if (!this.manuallyClosed && this.options.reconnect && this.reconnectAttempts < this.options.maxReconnectAttempts) {
          this.reconnectAttempts++;
          this.reconnectTimer = setTimeout(() => {
            this.reconnectTimer = null;
            void this.connect().catch((error) => this.emit('error', error));
          }, this.options.reconnectInterval);
        }
      };

      this.ws.onerror = () => {
        const err = new Error('WebSocket error');
        this.emit('error', err);
        if (!this.ws || this.ws.readyState !== WebSocket.OPEN) reject(err);
      };
    });
  }

  disconnect(): void {
    this.manuallyClosed = true;
    this.stopHeartbeat();
    if (this.reconnectTimer) {
      clearTimeout(this.reconnectTimer);
      this.reconnectTimer = null;
    }
    this.ws?.close();
    this.ws = null;
  }

  private startHeartbeat(): void {
    this.stopHeartbeat();
    if (this.options.heartbeatInterval <= 0 || this.options.heartbeatMessage === undefined) return;
    this.heartbeatTimer = setInterval(() => {
      if (!this.ws || this.ws.readyState !== WebSocket.OPEN) return;
      this.ws.send(this.encodeHeartbeat(this.options.heartbeatMessage));
      if (this.options.heartbeatTimeout > 0 && !this.heartbeatDeadline) {
        this.heartbeatDeadline = setTimeout(() => {
          this.heartbeatDeadline = null;
          this.emit('error', new Error('WebSocket heartbeat timeout'));
          this.ws?.close(4000, 'Heartbeat timeout');
        }, this.options.heartbeatTimeout);
      }
    }, this.options.heartbeatInterval);
  }

  private encodeHeartbeat(message: unknown): string {
    return this.options.heartbeatFormat === 'text' ? String(message) : JSON.stringify(message);
  }

  private heartbeatMatches(raw: string, parsed: unknown, expected: unknown): boolean {
    if (expected === undefined) return false;
    if (this.options.heartbeatFormat === 'text') return raw === String(expected);
    return jsonValuesEqual(parsed, expected);
  }

  private acknowledgeHeartbeat(): void {
    if (this.heartbeatDeadline) {
      clearTimeout(this.heartbeatDeadline);
      this.heartbeatDeadline = null;
    }
  }

  private stopHeartbeat(): void {
    if (this.heartbeatTimer) clearInterval(this.heartbeatTimer);
    if (this.heartbeatDeadline) clearTimeout(this.heartbeatDeadline);
    this.heartbeatTimer = null;
    this.heartbeatDeadline = null;
  }

  send(channel: string, payload: unknown): void {
    if (!this.ws || this.ws.readyState !== WebSocket.OPEN) {
      throw new Error('WebSocket is not connected');
    }
    this.ws.send(JSON.stringify({ channel, payload }));
  }

  subscribe<T = unknown>(channel: string, handler: MessageHandler<T>): () => void {
    if (!this.handlers.has(channel)) this.handlers.set(channel, new Set());
    this.handlers.get(channel)!.add(handler as MessageHandler);
    return () => { this.handlers.get(channel)?.delete(handler as MessageHandler); };
  }

  get connected(): boolean {
    return this.ws?.readyState === WebSocket.OPEN;
  }

<% for (const ch of it.channels) { %>
<% if (ch.canSubscribe) { %>
  /** Subscribe to <%= ch.name %> */
  on<%= ch.className %>(handler: MessageHandler<<%= ch.subscribeSchema && ch.subscribeSchema.properties.length > 0 ? `Types.${ch.className}Message` : 'unknown' %>>): () => void {
    return this.subscribe('<%= ch.name %>', handler);
  }

<% } %>
<% if (ch.canPublish) { %>
  /** Publish to <%= ch.name %> */
  send<%= ch.className %>(payload: <%= ch.publishSchema && ch.publishSchema.properties.length > 0 ? `Types.${ch.className}Payload` : 'unknown' %>): void {
    this.send('<%= ch.name %>', payload);
  }

<% } %>
<% } %>
}

function jsonValuesEqual(left: unknown, right: unknown): boolean {
  if (Object.is(left, right)) return true;
  if (Array.isArray(left) && Array.isArray(right)) {
    return left.length === right.length && left.every((value, index) => jsonValuesEqual(value, right[index]));
  }
  if (left && right && typeof left === 'object' && typeof right === 'object') {
    const leftObject = left as Record<string, unknown>;
    const rightObject = right as Record<string, unknown>;
    const leftKeys = Object.keys(leftObject).sort();
    const rightKeys = Object.keys(rightObject).sort();
    return leftKeys.length === rightKeys.length
      && leftKeys.every((key, index) => key === rightKeys[index] && jsonValuesEqual(leftObject[key], rightObject[key]));
  }
  return false;
}
