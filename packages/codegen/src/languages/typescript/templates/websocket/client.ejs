import type * as Types from './ws-types';

type EventHandler = (...args: unknown[]) => void;

class EventEmitter {
  private _events = new Map<string, Set<EventHandler>>();
  on(event: string, handler: EventHandler): this { if (!this._events.has(event)) this._events.set(event, new Set()); this._events.get(event)!.add(handler); return this; }
  off(event: string, handler: EventHandler): this { this._events.get(event)?.delete(handler); return this; }
  emit(event: string, ...args: unknown[]): boolean { const handlers = this._events.get(event); if (!handlers) return false; for (const h of handlers) h(...args); return true; }
}

export interface <%= it.clientClass %>Options {
  url?: string;
  protocols?: string | string[];
  reconnect?: boolean;
  reconnectInterval?: number;
  maxReconnectAttempts?: number;
  headers?: Record<string, string>;
}

type MessageHandler<T = unknown> = (data: T) => void;

export class <%= it.clientClass %> extends EventEmitter {
  private ws: WebSocket | null = null;
  private url: string;
  private options: Required<Pick<<%= it.clientClass %>Options, 'reconnect' | 'reconnectInterval' | 'maxReconnectAttempts'>>;
  private protocols?: string | string[];
  private handlers = new Map<string, Set<MessageHandler>>();
  private reconnectAttempts = 0;

  constructor(options: <%= it.clientClass %>Options = {}) {
    super();
    this.url = options.url ?? '<%= it.serverUrl %>';
    this.protocols = options.protocols;
    this.options = {
      reconnect: options.reconnect ?? true,
      reconnectInterval: options.reconnectInterval ?? 3000,
      maxReconnectAttempts: options.maxReconnectAttempts ?? 10,
    };
  }

  connect(): Promise<void> {
    return new Promise((resolve, reject) => {
      this.ws = new WebSocket(this.url, this.protocols);

      this.ws.onopen = () => {
        this.reconnectAttempts = 0;
        this.emit('connected');
        resolve();
      };

      this.ws.onmessage = (event) => {
        try {
          const data = JSON.parse(typeof event.data === 'string' ? event.data : new TextDecoder().decode(event.data as ArrayBuffer));
          const channel: string = data.channel ?? data.type ?? data.event ?? '';
          this.emit('message', data);
          if (channel && this.handlers.has(channel)) {
            for (const handler of this.handlers.get(channel)!) {
              handler(data.payload ?? data.data ?? data);
            }
          }
        } catch {
          this.emit('message', event.data);
        }
      };

      this.ws.onclose = (event) => {
        this.emit('disconnected', { code: event.code, reason: event.reason });
        if (this.options.reconnect && this.reconnectAttempts < this.options.maxReconnectAttempts) {
          this.reconnectAttempts++;
          setTimeout(() => this.connect(), this.options.reconnectInterval);
        }
      };

      this.ws.onerror = () => {
        const err = new Error('WebSocket error');
        this.emit('error', err);
        if (!this.ws || this.ws.readyState !== WebSocket.OPEN) reject(err);
      };
    });
  }

  disconnect(): void {
    this.options.reconnect = false;
    this.ws?.close();
    this.ws = null;
  }

  send(channel: string, payload: unknown): void {
    if (!this.ws || this.ws.readyState !== WebSocket.OPEN) {
      throw new Error('WebSocket is not connected');
    }
    this.ws.send(JSON.stringify({ channel, payload }));
  }

  subscribe<T = unknown>(channel: string, handler: MessageHandler<T>): () => void {
    if (!this.handlers.has(channel)) this.handlers.set(channel, new Set());
    this.handlers.get(channel)!.add(handler as MessageHandler);
    return () => { this.handlers.get(channel)?.delete(handler as MessageHandler); };
  }

  get connected(): boolean {
    return this.ws?.readyState === WebSocket.OPEN;
  }

<% for (const ch of it.channels) { %>
<% if (ch.canSubscribe) { %>
  /** Subscribe to <%= ch.name %> */
  on<%= ch.className %>(handler: MessageHandler<<%= ch.subscribeSchema && ch.subscribeSchema.properties.length > 0 ? `Types.${ch.className}Message` : 'unknown' %>>): () => void {
    return this.subscribe('<%= ch.name %>', handler);
  }

<% } %>
<% if (ch.canPublish) { %>
  /** Publish to <%= ch.name %> */
  send<%= ch.className %>(payload: <%= ch.publishSchema && ch.publishSchema.properties.length > 0 ? `Types.${ch.className}Payload` : 'unknown' %>): void {
    this.send('<%= ch.name %>', payload);
  }

<% } %>
<% } %>
}
