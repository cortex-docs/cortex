<% const channel = it.channel ?? {}; -%>
<% const channelId = channel.channelId ?? 'channel'; -%>
<% const className = channel.className ?? it.utils.toPascalCase(channelId.replace(/[^a-zA-Z0-9]+/g, '-')); -%>
<% const handlerName = channel.handlerName ?? ('on' + className); -%>
<% const sendName = channel.sendName ?? ('send' + className); -%>
<% if (channel.canSubscribe !== false && channel.subscribeMessage !== null) { -%>
// Subscribe to <%= channelId %>
ws.<%= handlerName %>((msg) => {
  console.log(msg);
});

<% } -%>
<% if (channel.canPublish !== false && channel.publishMessage) { -%>
// Send to <%= channelId %>
<% const props = (channel.publishMessage.properties ?? []).map(p => `${p.name}: ${p.type === 'number' || p.type === 'integer' ? '0' : `'value'`}`).join(', '); -%>
ws.<%= sendName %>({ <%= props %> });
<% } -%>
