<% const pkg = {
  name: it.packageName,
  version: it.version,
  description: 'TypeScript SDK for ' + it.title,
  type: 'module',
  main: './dist/index.js',
  types: './dist/index.d.ts',
  exports: { '.': { types: './dist/index.d.ts', import: './dist/index.js' } },
  scripts: { build: 'tsc', clean: 'rm -rf dist' },
  devDependencies: { typescript: '^5.8.0' },
  engines: { node: '>=18.0.0' },
};
if (it.hasGrpc) { pkg.dependencies = { '@grpc/grpc-js': '^1.12.0', '@grpc/proto-loader': '^0.7.0' }; }
%><%= JSON.stringify(pkg, null, 2) %>
