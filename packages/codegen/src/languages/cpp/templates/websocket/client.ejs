#pragma once

#include <string>
#include <map>
#include <vector>
#include <functional>
#include <memory>
#include <mutex>
#include <thread>
#include <atomic>
#include <chrono>
#include <cstring>
#include <sys/socket.h>
#include <netdb.h>
#include <unistd.h>
#include <nlohmann/json.hpp>
#include "ws-types.hpp"

namespace sdk::ws {

using MessageHandler = std::function<void(const nlohmann::json&)>;

class WsError : public std::runtime_error {
public:
  WsError(const std::string& msg) : std::runtime_error(msg) {}
};

struct <%= it.clientClass %>Options {
  std::string url = "<%= it.serverUrl %>";
  bool reconnect = true;
  int reconnect_interval_ms = 3000;
  int max_reconnect_attempts = 10;
  int heartbeat_interval_ms = <%= it.heartbeat.intervalMs %>;
  int heartbeat_timeout_ms = <%= it.heartbeat.timeoutMs %>;
  std::string heartbeat_message = <% if (it.heartbeat.hasClientMessage) { %><%= it.heartbeat.clientMessageLiteral %><% } else { %>""<% } %>;
  std::string heartbeat_response = <% if (it.heartbeat.hasClientResponse) { %><%= it.heartbeat.clientResponseLiteral %><% } else { %>""<% } %>;
  std::string server_heartbeat = <% if (it.heartbeat.hasServerMessage) { %><%= it.heartbeat.serverMessageLiteral %><% } else { %>""<% } %>;
  std::string server_response = <% if (it.heartbeat.hasServerResponse) { %><%= it.heartbeat.serverResponseLiteral %><% } else { %>""<% } %>;
};

class <%= it.clientClass %> {
  std::string url_;
  std::string host_;
  int port_ = 80;
  std::string path_;
  int sock_ = -1;
  std::atomic<bool> connected_{false};
  bool reconnect_;
  std::atomic<bool> should_reconnect_{true};
  std::atomic<bool> running_{false};
  std::atomic<int64_t> last_activity_ms_{0};
  int reconnect_interval_ms_;
  int max_reconnect_attempts_;
  int heartbeat_interval_ms_;
  int heartbeat_timeout_ms_;
  std::string heartbeat_message_;
  std::string heartbeat_response_;
  std::string server_heartbeat_;
  std::string server_response_;
  std::mutex handlers_mutex_;
  std::map<std::string, std::vector<MessageHandler>> handlers_;
  std::thread reader_thread_;
  std::thread heartbeat_thread_;
  std::mutex send_mutex_;

  static int64_t now_ms() {
    return std::chrono::duration_cast<std::chrono::milliseconds>(
      std::chrono::steady_clock::now().time_since_epoch()).count();
  }

  static bool heartbeat_matches(const std::string& actual, const std::string& expected) {
    if (expected.empty()) return false;
    if (actual == expected) return true;
    auto left = nlohmann::json::parse(actual, nullptr, false);
    auto right = nlohmann::json::parse(expected, nullptr, false);
    return !left.is_discarded() && !right.is_discarded() && left == right;
  }

  void parse_url() {
    std::string url = url_;
    if (url.substr(0, 5) == "ws://") url = url.substr(5);
    else if (url.substr(0, 6) == "wss://") url = url.substr(6);
    auto slash = url.find('/');
    if (slash != std::string::npos) {
      path_ = url.substr(slash);
      url = url.substr(0, slash);
    } else {
      path_ = "/";
    }
    auto colon = url.find(':');
    if (colon != std::string::npos) {
      host_ = url.substr(0, colon);
      port_ = std::stoi(url.substr(colon + 1));
    } else {
      host_ = url;
    }
  }

  void ws_send(const std::string& data) {
    std::lock_guard<std::mutex> send_lock(send_mutex_);
    std::vector<uint8_t> frame;
    frame.push_back(0x81);
    uint8_t mask_bit = 0x80;
    if (data.size() < 126) {
      frame.push_back(mask_bit | (uint8_t)data.size());
    } else if (data.size() < 65536) {
      frame.push_back(mask_bit | 126);
      frame.push_back((data.size() >> 8) & 0xFF);
      frame.push_back(data.size() & 0xFF);
    } else {
      frame.push_back(mask_bit | 127);
      for (int i = 7; i >= 0; --i) frame.push_back((data.size() >> (i * 8)) & 0xFF);
    }
    uint8_t mask[4] = {0x12, 0x34, 0x56, 0x78};
    frame.insert(frame.end(), mask, mask + 4);
    for (size_t i = 0; i < data.size(); ++i) {
      frame.push_back(data[i] ^ mask[i % 4]);
    }
    ::send(sock_, frame.data(), frame.size(), 0);
  }

  std::string ws_recv() {
    uint8_t header[2];
    if (recv(sock_, header, 2, MSG_WAITALL) != 2) return "";
    uint8_t opcode = header[0] & 0x0F;
    uint64_t len = header[1] & 0x7F;
    bool masked = header[1] & 0x80;
    if (len == 126) {
      uint8_t ext[2];
      recv(sock_, ext, 2, MSG_WAITALL);
      len = (ext[0] << 8) | ext[1];
    } else if (len == 127) {
      uint8_t ext[8];
      recv(sock_, ext, 8, MSG_WAITALL);
      len = 0;
      for (int i = 0; i < 8; ++i) len = (len << 8) | ext[i];
    }
    uint8_t mask[4] = {};
    if (masked) recv(sock_, mask, 4, MSG_WAITALL);
    std::string data(len, 0);
    size_t received = 0;
    while (received < len) {
      int r = recv(sock_, &data[received], len - received, 0);
      if (r <= 0) return "";
      received += r;
    }
    if (masked) for (size_t i = 0; i < len; ++i) data[i] ^= mask[i % 4];
    if (opcode == 0x8) return "";
    return data;
  }

  bool do_connect() {
    struct addrinfo hints{}, *res;
    hints.ai_family = AF_INET;
    hints.ai_socktype = SOCK_STREAM;
    if (getaddrinfo(host_.c_str(), std::to_string(port_).c_str(), &hints, &res) != 0) return false;

    sock_ = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
    if (sock_ < 0) { freeaddrinfo(res); return false; }
    if (::connect(sock_, res->ai_addr, res->ai_addrlen) < 0) {
      ::close(sock_); sock_ = -1; freeaddrinfo(res); return false;
    }
    freeaddrinfo(res);

    std::string key = "dGhlIHNhbXBsZSBub25jZQ==";
    std::string handshake = "GET " + path_ + " HTTP/1.1\r\n"
      "Host: " + host_ + ":" + std::to_string(port_) + "\r\n"
      "Upgrade: websocket\r\n"
      "Connection: Upgrade\r\n"
      "Sec-WebSocket-Key: " + key + "\r\n"
      "Sec-WebSocket-Version: 13\r\n"
      "\r\n";
    ::send(sock_, handshake.c_str(), handshake.size(), 0);

    char buf[4096];
    int n = recv(sock_, buf, sizeof(buf) - 1, 0);
    if (n <= 0) { ::close(sock_); sock_ = -1; return false; }

    connected_ = true;
    last_activity_ms_ = now_ms();
    return true;
  }

  void reader_loop() {
    int reconnect_attempts = 0;
    while (running_) {
      while (connected_ && running_) {
        auto msg = ws_recv();
        if (msg.empty()) { connected_ = false; break; }
        if (heartbeat_matches(msg, server_heartbeat_)) {
          last_activity_ms_ = now_ms();
          if (!server_response_.empty()) ws_send(server_response_);
          continue;
        }
        if (heartbeat_response_.empty() || heartbeat_matches(msg, heartbeat_response_)) {
          last_activity_ms_ = now_ms();
          if (!heartbeat_response_.empty()) continue;
        }
        auto data = nlohmann::json::parse(msg, nullptr, false);
        if (data.is_discarded()) continue;

        std::string channel;
        if (data.contains("channel")) channel = data["channel"].get<std::string>();
        else if (data.contains("type")) channel = data["type"].get<std::string>();
        else if (data.contains("event")) channel = data["event"].get<std::string>();
        auto payload = data.contains("payload") ? data["payload"]
                     : data.contains("data") ? data["data"] : data;

        std::lock_guard<std::mutex> lock(handlers_mutex_);
        auto it = handlers_.find(channel);
        if (it != handlers_.end()) for (const auto& handler : it->second) handler(payload);
      }

      if (!running_ || !should_reconnect_) break;
      if (sock_ >= 0) { ::close(sock_); sock_ = -1; }
      bool reconnected = false;
      while (running_ && reconnect_attempts < max_reconnect_attempts_) {
        ++reconnect_attempts;
        std::this_thread::sleep_for(std::chrono::milliseconds(reconnect_interval_ms_));
        if (!running_) break;
        if (do_connect()) { reconnect_attempts = 0; reconnected = true; break; }
      }
      if (!reconnected) break;
    }
  }

  void heartbeat_loop() {
    while (running_ && heartbeat_interval_ms_ > 0 && !heartbeat_message_.empty()) {
      int waited = 0;
      while (running_ && waited < heartbeat_interval_ms_) {
        int slice = std::min(100, heartbeat_interval_ms_ - waited);
        std::this_thread::sleep_for(std::chrono::milliseconds(slice));
        waited += slice;
      }
      if (!running_ || !connected_) continue;
      if (heartbeat_timeout_ms_ > 0 && now_ms() - last_activity_ms_ > heartbeat_interval_ms_ + heartbeat_timeout_ms_) {
        ::shutdown(sock_, SHUT_RDWR);
        continue;
      }
      ws_send(heartbeat_message_);
    }
  }

public:
  explicit <%= it.clientClass %>(const <%= it.clientClass %>Options& opts = {})
    : url_(opts.url),
      reconnect_(opts.reconnect),
      should_reconnect_(opts.reconnect),
      reconnect_interval_ms_(opts.reconnect_interval_ms),
      max_reconnect_attempts_(opts.max_reconnect_attempts),
      heartbeat_interval_ms_(opts.heartbeat_interval_ms),
      heartbeat_timeout_ms_(opts.heartbeat_timeout_ms),
      heartbeat_message_(opts.heartbeat_message),
      heartbeat_response_(opts.heartbeat_response),
      server_heartbeat_(opts.server_heartbeat),
      server_response_(opts.server_response) {
    parse_url();
  }

  ~<%= it.clientClass %>() {
    disconnect();
  }

  void connect() {
    should_reconnect_ = reconnect_;
    running_ = true;
    if (!do_connect()) { running_ = false; throw WsError("WebSocket connection failed"); }
    reader_thread_ = std::thread([this] { reader_loop(); });
    if (heartbeat_interval_ms_ > 0 && !heartbeat_message_.empty()) heartbeat_thread_ = std::thread([this] { heartbeat_loop(); });
  }

  void disconnect() {
    should_reconnect_ = false;
    running_ = false;
    connected_ = false;
    if (sock_ >= 0) { ::close(sock_); sock_ = -1; }
    if (reader_thread_.joinable()) reader_thread_.join();
    if (heartbeat_thread_.joinable()) heartbeat_thread_.join();
  }

  void send(const std::string& channel, const nlohmann::json& payload) {
    if (!connected_) throw WsError("WebSocket is not connected");
    nlohmann::json msg = {{"channel", channel}, {"payload", payload}};
    ws_send(msg.dump());
  }

  void subscribe(const std::string& channel, MessageHandler handler) {
    std::lock_guard<std::mutex> lock(handlers_mutex_);
    handlers_[channel].push_back(std::move(handler));
  }

  bool is_connected() const { return connected_; }

<% for (const ch of it.channels) { %>
<% if (ch.canSubscribe) { %>
  void on_<%= ch.methodName %>(MessageHandler handler) {
    subscribe("<%= ch.name %>", std::move(handler));
  }

<% } %>
<% if (ch.canPublish) { %>
  void send_<%= ch.methodName %>(const nlohmann::json& payload) {
    send("<%= ch.name %>", payload);
  }

<% } %>
<% } %>
};

} // namespace sdk::ws
