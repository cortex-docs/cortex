#pragma once

#include <string>
#include <vector>
#include <optional>
#include <cstdint>
#include <nlohmann/json.hpp>

namespace sdk::ws {

<% for (const schema of it.schemas) { %>
struct <%= schema.className %> {
<% for (const prop of schema.properties) { %>
<% if (prop.required) { %>
  <%= prop.type %> <%= prop.name %>;
<% } else { %>
  std::optional<<%= prop.type %>> <%= prop.name %>;
<% } %>
<% } %>
};

inline void to_json(nlohmann::json& j, const <%= schema.className %>& v) {
  j = nlohmann::json{};
<% for (const prop of schema.properties) { %>
<% if (prop.required) { %>
  j["<%= prop.originalName %>"] = v.<%= prop.name %>;
<% } else { %>
  if (v.<%= prop.name %>.has_value()) j["<%= prop.originalName %>"] = v.<%= prop.name %>.value();
<% } %>
<% } %>
}

inline void from_json(const nlohmann::json& j, <%= schema.className %>& v) {
<% for (const prop of schema.properties) { %>
<% if (prop.required) { %>
  if (j.contains("<%= prop.originalName %>")) j.at("<%= prop.originalName %>").get_to(v.<%= prop.name %>);
<% } else { %>
  if (j.contains("<%= prop.originalName %>") && !j["<%= prop.originalName %>"].is_null()) v.<%= prop.name %> = j["<%= prop.originalName %>"].get<<%= prop.type %>>();
<% } %>
<% } %>
}

<% } %>
<% for (const ch of it.channels) { %>
<% if (ch.subscribeSchema && ch.subscribeSchema.properties.length > 0) { %>
struct <%= ch.className %>Message {
<% for (const prop of ch.subscribeSchema.properties) { %>
<% if (prop.required) { %>
  <%= prop.type %> <%= prop.name %>;
<% } else { %>
  std::optional<<%= prop.type %>> <%= prop.name %>;
<% } %>
<% } %>
};

inline void from_json(const nlohmann::json& j, <%= ch.className %>Message& v) {
<% for (const prop of ch.subscribeSchema.properties) { %>
<% if (prop.required) { %>
  if (j.contains("<%= prop.originalName %>")) j.at("<%= prop.originalName %>").get_to(v.<%= prop.name %>);
<% } else { %>
  if (j.contains("<%= prop.originalName %>") && !j["<%= prop.originalName %>"].is_null()) v.<%= prop.name %> = j["<%= prop.originalName %>"].get<<%= prop.type %>>();
<% } %>
<% } %>
}

<% } %>
<% if (ch.publishSchema && ch.publishSchema.properties.length > 0) { %>
struct <%= ch.className %>Payload {
<% for (const prop of ch.publishSchema.properties) { %>
<% if (prop.required) { %>
  <%= prop.type %> <%= prop.name %>;
<% } else { %>
  std::optional<<%= prop.type %>> <%= prop.name %>;
<% } %>
<% } %>
};

inline void to_json(nlohmann::json& j, const <%= ch.className %>Payload& v) {
  j = nlohmann::json{};
<% for (const prop of ch.publishSchema.properties) { %>
<% if (prop.required) { %>
  j["<%= prop.originalName %>"] = v.<%= prop.name %>;
<% } else { %>
  if (v.<%= prop.name %>.has_value()) j["<%= prop.originalName %>"] = v.<%= prop.name %>.value();
<% } %>
<% } %>
}

<% } %>
<% } %>
} // namespace sdk::ws
