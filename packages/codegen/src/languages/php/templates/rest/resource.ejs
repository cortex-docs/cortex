<% const r = it.resource; -%>
<% const ns = it.naming.className(it.config.languageConfig.package_name.replace(/[\/.]+/g, '-')); -%>
<% const clientClass = it.clientClass; -%>
<?php

declare(strict_types=1);

namespace <%= ns %>;

class <%= r.className %>
{
    public function __construct(
        private readonly <%= clientClass %> $client,
    ) {}

<% for (const op of r.operations) { -%>
<% const params = []; -%>
<% for (const p of op.pathParams) { params.push(`string $${p.name}`); } -%>
<% if (op.hasBody) { params.push(op.isRawBinary ? 'FileUpload $body' : 'array $body'); } -%>
<% if (op.queryParams.length > 0) { params.push('?array $query = null'); } -%>
<% let pathExpr = `'${op.path}'`; -%>
<% if (op.pathParams.length > 0) { let expr = `'${op.path}'`; for (const p of op.pathParams) { expr = `str_replace('{${p.originalName}}', $${p.name}, ${expr})`; } pathExpr = expr; } -%>
<% const queryArg = op.queryParams.length > 0 ? '$query' : 'null'; -%>
<% const bodyArg = op.hasBody ? '$body' : 'null'; -%>
<% if (op.summary) { -%>
    /** <%= op.summary %> */
<% } -%>
    public function <%= op.name %>(<%= params.join(', ') %>): mixed
    {
        return $this->client->request('<%= op.method %>', <%= pathExpr %>, <%= queryArg %>, <%= bodyArg %><% if (op.isMultipart) { %>, true<% } %><% if (op.isRawBinary) { %>, false, true, '<%= op.contentType %>'<% } %>);
    }

<% } -%>
}
