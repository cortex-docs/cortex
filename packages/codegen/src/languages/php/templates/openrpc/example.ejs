<% const method = it.method; -%>
<% const callName = it.naming?.methodName?.(method.name) ?? method.methodName ?? method.name; -%>
<% const params = (method.params ?? []).map(p => `'${p.name}' => ${p.type === 'number' || p.type === 'integer' ? '0' : p.type === 'boolean' ? 'true' : "'value'"}`); -%>
<% if (params.length > 0) { -%>
$result = $client-><%= callName %>([
    <%= params.join(",\n    ") %>,
]);
<% } else { -%>
$result = $client-><%= callName %>();
<% } -%>
var_dump($result);
