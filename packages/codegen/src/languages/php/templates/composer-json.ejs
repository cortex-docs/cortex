<% const composer = {
  name: it.packageName,
  description: 'PHP SDK for ' + it.title,
  type: 'library',
  require: { php: '>=8.1', 'guzzlehttp/guzzle': '^7.0' },
  autoload: { 'psr-4': {} },
};
composer.autoload['psr-4'][it.utils.toPascalCase(it.packageName) + '\\'] = 'src/';
if (it.hasWs) { composer.require['ratchet/pawl'] = '^0.4'; }
if (it.hasGrpc) { composer.require['grpc/grpc'] = '^1.60'; }
%><%= JSON.stringify(composer, null, 4) %>
