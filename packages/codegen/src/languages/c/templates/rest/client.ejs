#ifndef SDK_CLIENT_H
#define SDK_CLIENT_H

#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include <stdint.h>
#include <curl/curl.h>
#include "cjson/cJSON.h"
#include "types.h"

