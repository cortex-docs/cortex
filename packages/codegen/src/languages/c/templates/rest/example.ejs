<% const op = it.op; const resource = it.resource; -%>
<% const prefix = 'sdk_' + it.naming.propertyName(resource.name); -%>
// <%= op.summary || op.name %>
<% if (op.method === 'DELETE' && op.responseType === 'void') { -%>
<%= prefix %>_<%= op.name %>(&client, <%= op.pathParams.map(p => `"example-${p.originalName}"`).join(', ') %>);
<% } else if (op.method === 'GET' && op.pathParams.length === 0) { -%>
cJSON* <%= it.utils.toSnakeCase(resource.name) %> = <%= prefix %>_<%= op.name %>(&client<% if (op.queryParams.length > 0) { %>, <%= op.queryParams.map(q => `${q.type === 'int' || q.type === 'float' ? '"10"' : '"value"'}`).join(', ') %><% } else { %>, NULL<% } %>);
cJSON_Delete(<%= it.utils.toSnakeCase(resource.name) %>);
<% } else if (op.method === 'GET' && op.pathParams.length > 0) { -%>
<% const respCType = 'sdk_' + it.utils.toSnakeCase(op.responseType) + '_t'; -%>
<%= respCType %> <%= it.utils.toSnakeCase(it.utils.singularize(resource.name)) %> = <%= prefix %>_<%= op.name %>(&client, <%= op.pathParams.map(p => `"example-${p.originalName}"`).join(', ') %>);
sdk_<%= it.utils.toSnakeCase(op.responseType) %>_free(&<%= it.utils.toSnakeCase(it.utils.singularize(resource.name)) %>);
<% } else if (op.hasBody && op.pathParams.length === 0) { -%>
<% const bodyCType = 'sdk_' + it.utils.toSnakeCase(op.bodyType) + '_t'; -%>
<%= bodyCType %> body = {
<% const bodySchema = it.schemas.find(s => s.className === op.bodyType); -%>
<% if (bodySchema) { for (const prop of bodySchema.properties.filter(p => p.required)) { -%>
  .<%= prop.name %> = <%= prop.type === 'char*' || prop.type === 'const char*' ? '"value"' : '0' %>,
<% } } else { -%>
  /* <%= op.bodyType %> fields */
<% } -%>
};
<% const createRespCType = 'sdk_' + it.utils.toSnakeCase(op.responseType) + '_t'; -%>
<%= createRespCType %> created = <%= prefix %>_<%= op.name %>(&client, &body);
sdk_<%= it.utils.toSnakeCase(op.responseType) %>_free(&created);
<% } else if (op.hasBody && op.pathParams.length > 0) { -%>
<% const updBodyCType = 'sdk_' + it.utils.toSnakeCase(op.bodyType) + '_t'; -%>
<%= updBodyCType %> body = {
<% const updBodySchema = it.schemas.find(s => s.className === op.bodyType); -%>
<% if (updBodySchema) { for (const prop of updBodySchema.properties.slice(0, 3)) { -%>
  .<%= prop.name %> = <%= prop.type === 'char*' || prop.type === 'const char*' ? '"value"' : '0' %>,
<% } } else { -%>
  /* <%= op.bodyType %> fields */
<% } -%>
};
<% const updRespCType = 'sdk_' + it.utils.toSnakeCase(op.responseType) + '_t'; -%>
<%= updRespCType %> updated = <%= prefix %>_<%= op.name %>(&client, <%= op.pathParams.map(p => `"example-${p.originalName}"`).join(', ') %>, &body);
sdk_<%= it.utils.toSnakeCase(op.responseType) %>_free(&updated);
<% } -%>
