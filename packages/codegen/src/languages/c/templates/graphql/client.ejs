static inline gql_query_result_t gql_query(gql_client_t* client, gql_query_builder_t* builder) {
  gql_document_t doc = gql_builder_build(builder);
  cJSON* raw = gql_execute(client, doc.query, doc.variables);
  gql_document_free(&doc);
  gql_query_result_t result;
  gql_query_result_from_json(raw, &result);
  if (raw) cJSON_Delete(raw);
  return result;
}
