typedef struct {
  char* endpoint;
<% if (hasSubscriptions) { -%>
  char* ws_endpoint;
<% } -%>
} gql_client_options_t;

typedef struct {
  char* data;
  size_t size;
} gql_resp_buf_t;

static size_t gql_write_cb(void* contents, size_t size, size_t nmemb, void* userp) {
  size_t total = size * nmemb;
  gql_resp_buf_t* buf = (gql_resp_buf_t*)userp;
  char* tmp = (char*)realloc(buf->data, buf->size + total + 1);
  if (!tmp) return 0;
  buf->data = tmp;
  memcpy(buf->data + buf->size, contents, total);
  buf->size += total;
  buf->data[buf->size] = '\0';
  return total;
}

typedef struct {
  char* endpoint;
<% if (hasSubscriptions) { -%>
  char* ws_endpoint;
<% } -%>
} gql_client_t;

static inline void gql_client_init(gql_client_t* c, const gql_client_options_t* opts) {
  memset(c, 0, sizeof(*c));
  c->endpoint = strdup(opts->endpoint);
<% if (hasSubscriptions) { -%>
  if (opts->ws_endpoint && opts->ws_endpoint[0]) {
    c->ws_endpoint = strdup(opts->ws_endpoint);
  } else {
    c->ws_endpoint = strdup(opts->endpoint);
    if (strncmp(c->ws_endpoint, "https", 5) == 0) {
      char* tmp = (char*)malloc(strlen(c->ws_endpoint) + 1);
      sprintf(tmp, "wss%s", c->ws_endpoint + 5);
      free(c->ws_endpoint);
      c->ws_endpoint = tmp;
    } else if (strncmp(c->ws_endpoint, "http", 4) == 0) {
      char* tmp = (char*)malloc(strlen(c->ws_endpoint) + 1);
      sprintf(tmp, "ws%s", c->ws_endpoint + 4);
      free(c->ws_endpoint);
      c->ws_endpoint = tmp;
    }
  }
<% } -%>
}

static inline void gql_client_free(gql_client_t* c) {
  free(c->endpoint);
<% if (hasSubscriptions) { -%>
  free(c->ws_endpoint);
<% } -%>
  memset(c, 0, sizeof(*c));
}

static inline cJSON* gql_execute(gql_client_t* client, const char* query, const cJSON* variables) {
  CURL* curl = curl_easy_init();
  if (!curl) return NULL;

  cJSON* req_body = cJSON_CreateObject();
  cJSON_AddStringToObject(req_body, "query", query);
  if (variables && !cJSON_IsNull(variables) && cJSON_GetArraySize(variables) > 0) {
    cJSON_AddItemToObject(req_body, "variables", cJSON_Duplicate(variables, 1));
  }
  char* body_str = cJSON_PrintUnformatted(req_body);
  cJSON_Delete(req_body);

  gql_resp_buf_t resp = {NULL, 0};
  struct curl_slist* headers = NULL;
  headers = curl_slist_append(headers, "Content-Type: application/json");

  curl_easy_setopt(curl, CURLOPT_URL, client->endpoint);
  curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
  curl_easy_setopt(curl, CURLOPT_POST, 1L);
  curl_easy_setopt(curl, CURLOPT_POSTFIELDS, body_str);
  curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, gql_write_cb);
  curl_easy_setopt(curl, CURLOPT_WRITEDATA, &resp);
  curl_easy_setopt(curl, CURLOPT_TIMEOUT, 30L);

  CURLcode res = curl_easy_perform(curl);
  curl_slist_free_all(headers);
  curl_easy_cleanup(curl);
  free(body_str);

  if (res != CURLE_OK) { free(resp.data); return NULL; }

  cJSON* json = cJSON_Parse(resp.data);
  free(resp.data);
  if (!json) return NULL;

  cJSON* data = cJSON_GetObjectItem(json, "data");
  if (data) {
    cJSON* result = cJSON_Duplicate(data, 1);
    cJSON_Delete(json);
    return result;
  }
  cJSON_Delete(json);
  return NULL;
}
