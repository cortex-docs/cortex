<% const method = it.method; -%>
<% const serviceName = it.service.serviceName; -%>
<% const clientVar = it.service.clientVar ?? (serviceName.charAt(0).toLowerCase() + serviceName.slice(1).replace(/Service$/, '').replace(/([A-Z])/g, '_$1').toLowerCase().replace(/^_/, '') + '_client'); -%>
<% const methodCall = method.methodName.replace(/([A-Z])/g, '_$1').toLowerCase().replace(/^_/, ''); -%>
<% const inputType = method.inputType; -%>
<% const fields = (method.inputFields ?? []).map(f => `${f.name}: ${f.type === 'number' || f.type === 'integer' ? '0' : "'value'"}`); -%>
<% const args = fields.length > 0 ? `{ ${fields.join(', ')} }` : '{}'; -%>
<% if (method.serverStreaming) { -%>
# <%= method.methodName %> (server streaming)
<%= clientVar %>.<%= methodCall %>(<%= args %>) { |item| puts item }
<% } else if (method.clientStreaming) { -%>
# <%= method.methodName %> (client streaming)
stream = <%= clientVar %>.<%= methodCall %>
stream.write(<%= args %>)
result = stream.close
<% } else { -%>
# <%= method.methodName %>
result = <%= clientVar %>.<%= methodCall %>(<%= args %>)
<% } -%>
