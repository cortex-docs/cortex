        self,
<% for (const p of params) { -%>
<% const paramType = it.mapJsonSchemaType(p.schema ?? p); -%>
<% if (p.required === false) { -%>
        <%= it.naming.parameterName(p.name) %>: Optional[<%= paramType %>] = None,
<% } else { -%>
        <%= it.naming.parameterName(p.name) %>: <%= paramType %> = None,
<% } -%>
<% } -%>
    ) -> <%= returnType %>:
        params: Dict[str, Any] = {}
<% for (const p of params) { -%>
        if <%= it.naming.parameterName(p.name) %> is not None:
            params['<%= p.name %>'] = <%= it.naming.parameterName(p.name) %>
<% } -%>
        return self._call('<%= method.name %>', params)
<% } else { -%>
    def <%= methodName %>(self) -> <%= returnType %>:
        return self._call('<%= method.name %>')
<% } -%>

