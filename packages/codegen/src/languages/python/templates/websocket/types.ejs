class <%= ch.className %>Payload(CortexModel):
<% for (const prop of ch.publishSchema.properties) { %>
<% const needsAlias = prop.name !== prop.originalName; -%>
    <%= prop.name %>: <% if (!prop.required) { %>Optional[<%= prop.type %>]<% } else { %><%= prop.type %><% } %><% if (needsAlias) { %> = Field(<%= !prop.required ? 'None, ' : '' %>alias="<%= prop.originalName %>")<% } else { %><%= !prop.required ? ' = None' : '' %><% } %>
<% } %>

<% } %>
<% } %>
