    def <%= it.naming.methodName(method.name) %>(self, request: <%= method.inputType %>, timeout: Optional[float] = None) -> <%= method.outputType %>:
        request_model = _coerce_message(<%= method.inputType %>, request)
        if self._base_url:
            payload = _post_json(self._base_url, "<%= service.name %>", "<%= method.name %>", request_model, timeout)
            return _coerce_message(<%= method.outputType %>, payload)
        return self._channels["<%= service.name %>"].unary_unary(
            "/<%= it.protoPackage %>.<%= service.name %>/<%= method.name %>",
            request_serializer=_serialize_json,
            response_deserializer=_deserialize_json(<%= method.outputType %>),
        )(request_model, timeout=timeout)

<% } else if (!method.clientStreaming && method.serverStreaming) { %>
    def <%= it.naming.methodName(method.name) %>(self, request: <%= method.inputType %>, timeout: Optional[float] = None) -> Iterator[<%= method.outputType %>]:
        request_model = _coerce_message(<%= method.inputType %>, request)
        if self._base_url:
            payload = _post_json(self._base_url, "<%= service.name %>", "<%= method.name %>", request_model, timeout)
            items = payload.get("data", payload) if isinstance(payload, Mapping) else payload
            return iter(_coerce_message(<%= method.outputType %>, item) for item in items)
        return self._channels["<%= service.name %>"].unary_stream(
            "/<%= it.protoPackage %>.<%= service.name %>/<%= method.name %>",
            request_serializer=_serialize_json,
            response_deserializer=_deserialize_json(<%= method.outputType %>),
        )(request_model, timeout=timeout)

<% } else if (method.clientStreaming && !method.serverStreaming) { %>
    def <%= it.naming.methodName(method.name) %>(self, request_iterator: Iterator[<%= method.inputType %>], timeout: Optional[float] = None) -> <%= method.outputType %>:
        if self._base_url:
            raise NotImplementedError("HTTP-backed gRPC client streaming is not supported")
        return self._channels["<%= service.name %>"].stream_unary(
            "/<%= it.protoPackage %>.<%= service.name %>/<%= method.name %>",
            request_serializer=_serialize_json,
            response_deserializer=_deserialize_json(<%= method.outputType %>),
        )(request_iterator, timeout=timeout)

<% } else { %>
    def <%= it.naming.methodName(method.name) %>(self, request_iterator: Iterator[<%= method.inputType %>], timeout: Optional[float] = None) -> Iterator[<%= method.outputType %>]:
        if self._base_url:
            raise NotImplementedError("HTTP-backed gRPC bidirectional streaming is not supported")
        return self._channels["<%= service.name %>"].stream_stream(
            "/<%= it.protoPackage %>.<%= service.name %>/<%= method.name %>",
            request_serializer=_serialize_json,
            response_deserializer=_deserialize_json(<%= method.outputType %>),
        )(request_iterator, timeout=timeout)

