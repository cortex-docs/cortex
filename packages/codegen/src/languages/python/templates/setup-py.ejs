from setuptools import setup, find_packages

setup(
    name="<%= it.packageName %>",
    version="<%= it.version %>",
    description="Python SDK for <%= it.title %>",
    packages=find_packages(),
    python_requires=">=3.9",
    install_requires=[
        "httpx>=0.27.0",
        "pydantic>=2.0.0",
<% if (it.hasWs) { %>        "websockets>=13.0",
<% } %><% if (it.hasGql) { %>        "websockets>=12.0",
<% } %><% if (it.hasGrpc) { %>        "grpcio>=1.68.0",
        "protobuf>=5.0",
<% } %>    ],
)
