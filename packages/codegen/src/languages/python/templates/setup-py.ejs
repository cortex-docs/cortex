from setuptools import setup

module_name = "<%= it.packageName.replace(/[-.]/g, '_') %>"

setup(
    name="<%= it.packageName %>",
    version="<%= it.version %>",
    description="Python SDK for <%= it.title %>",
<% if (it.repositoryUrl) { %>    url="<%= it.repositoryUrl %>",
    project_urls={"Source": "<%= it.repositoryUrl %>", "Issues": "<%= it.repositoryUrl %>/issues"},
<% } %>
    packages=[module_name, f"{module_name}.resources"],
    package_dir={module_name: "src", f"{module_name}.resources": "src/resources"},
    python_requires=">=3.9",
    install_requires=[
        "httpx>=0.27.0",
        "pydantic>=2.0.0",
<% if (it.hasWs) { %>        "websockets>=13.0",
<% } %><% if (it.hasGql) { %>        "websockets>=12.0",
<% } %><% if (it.hasGrpc) { %>        "grpcio>=1.68.0",
        "protobuf>=5.0",
<% } %>    ],
)
