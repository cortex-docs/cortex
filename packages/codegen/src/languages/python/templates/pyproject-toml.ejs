[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta:__legacy__"

[project]
name = "<%= it.packageName %>"
version = "<%= it.version %>"
description = "Python SDK for <%= it.title %>"
requires-python = ">=3.9"
dependencies = [
    "httpx>=0.27.0",
    "pydantic>=2.0.0",
<% if (it.hasWs) { %>    "websockets>=13.0",
<% } %><% if (it.hasGql) { %>    "websockets>=12.0",
<% } %><% if (it.hasGrpc) { %>    "grpcio>=1.68.0",
    "protobuf>=5.0",
<% } %>]
<% if (it.repositoryUrl) { %>
[project.urls]
Repository = "<%= it.repositoryUrl %>"
Issues = "<%= it.repositoryUrl %>/issues"
<% } %>

[tool.setuptools]
packages = ["<%= it.packageName.replace(/[-.]/g, '_') %>", "<%= it.packageName.replace(/[-.]/g, '_') %>.resources"]
package-dir = {"<%= it.packageName.replace(/[-.]/g, '_') %>" = "src", "<%= it.packageName.replace(/[-.]/g, '_') %>.resources" = "src/resources"}
