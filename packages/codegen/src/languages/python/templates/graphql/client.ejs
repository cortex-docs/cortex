<% const hasQueries = it.queries.length > 0; -%>
<% const hasMutations = it.mutations.length > 0; -%>
<% const hasSubscriptions = it.subscriptions.length > 0; -%>
from __future__ import annotations

import json
<% if (hasSubscriptions) { -%>
import asyncio
import threading
<% } -%>
from typing import Any, Callable, Optional
import httpx

from . import gql_query_builder as _builder


class _Namespace:
    def __init__(self, data: dict[str, Any]) -> None:
        for k, v in data.items():
            setattr(self, k, _wrap(v))

    def __repr__(self) -> str:
        return repr(self.__dict__)


def _wrap(value: Any) -> Any:
    if isinstance(value, dict):
        return _Namespace(value)
    if isinstance(value, list):
        return [_wrap(i) for i in value]
    return value


class GqlError(Exception):
    def __init__(self, message: str, errors: list[dict]) -> None:
        self.errors = errors
        super().__init__(message)


class <%= it.clientClass %>:
    def __init__(
        self,
        *,
        endpoint: str = "<%= it.endpoint %>",
<% if (hasSubscriptions) { -%>
        ws_endpoint: Optional[str] = None,
<% } -%>
        bearer_token: Optional[str] = None,
        headers: Optional[dict[str, str]] = None,
    ) -> None:
        self.endpoint = endpoint
        self._headers: dict[str, str] = {
            "Content-Type": "application/json",
            **(headers or {}),
        }
        if bearer_token:
            self._headers["Authorization"] = f"Bearer {bearer_token}"
<% if (hasSubscriptions) { -%>
        self.ws_endpoint = ws_endpoint or endpoint.replace("http", "ws", 1)
<% } -%>

    def _execute(self, query: str, variables: Optional[dict] = None) -> Any:
        with httpx.Client() as client:
            response = client.post(
                self.endpoint,
                json={"query": query, "variables": variables or {}},
                headers=self._headers,
            )
        data = response.json()
        if "errors" in data and data["errors"]:
            raise GqlError(
                "; ".join(e["message"] for e in data["errors"]), data["errors"]
            )
        return data.get("data")
<% if (hasQueries) { %>
    def query(self, fn: Callable[[_builder.QueryBuilder], _builder.QueryBuilder]) -> Any:
        builder = _builder.create_query_builder()
        fn(builder)
        query, variables = builder._build_document("query")
        return _wrap(self._execute(query, variables))
<% } -%>
<% if (hasMutations) { %>
    def mutate(self, fn: Callable[[_builder.MutationBuilder], _builder.MutationBuilder]) -> Any:
        builder = _builder.create_mutation_builder()
        fn(builder)
        query, variables = builder._build_document("mutation")
        return _wrap(self._execute(query, variables))
<% } -%>
<% if (hasSubscriptions) { %>
    async def _subscribe_ws(
        self, query: str, variables: dict[str, Any]
    ):
        import websockets

        extra_headers = {
            k: v for k, v in self._headers.items() if k != "Content-Type"
        }
        async with websockets.connect(
            self.ws_endpoint,
            subprotocols=["graphql-transport-ws"],
            additional_headers=extra_headers or None,
        ) as ws:
            await ws.send(json.dumps({"type": "connection_init"}))
            ack = json.loads(await ws.recv())
            if ack.get("type") != "connection_ack":
                raise GqlError(
                    f"Expected connection_ack, got {ack.get('type')}", []
                )

            await ws.send(
                json.dumps(
                    {
                        "type": "subscribe",
                        "id": "1",
                        "payload": {"query": query, "variables": variables},
                    }
                )
            )

            while True:
                raw = json.loads(await ws.recv())
                msg_type = raw.get("type")
                if msg_type == "next":
                    yield raw["payload"]["data"]
                elif msg_type == "complete":
                    break
                elif msg_type == "error":
                    errors = raw.get("payload", [])
                    raise GqlError(
                        "; ".join(
                            e.get("message", str(e)) for e in errors
                        ),
                        errors,
                    )

    async def subscribe_once(
        self, fn: Callable[[_builder.SubscriptionBuilder], _builder.SubscriptionBuilder], timeout: float = 10.0
    ) -> Any:
        builder = _builder.create_subscription_builder()
        fn(builder)
        query, variables = builder._build_document("subscription")

        async def _get_first() -> Any:
            async for data in self._subscribe_ws(query, variables):
                return _wrap(data)
            raise GqlError("subscription completed without data", [])

        return await asyncio.wait_for(_get_first(), timeout=timeout)

    def subscribe(
        self,
        fn: Callable[[_builder.SubscriptionBuilder], _builder.SubscriptionBuilder],
        on_data: Callable,
        on_error: Optional[Callable] = None,
    ) -> Callable:
        builder = _builder.create_subscription_builder()
        fn(builder)
        query, variables = builder._build_document("subscription")

        stopped = threading.Event()

        def _worker() -> None:
            async def _run() -> None:
                try:
                    async for data in self._subscribe_ws(query, variables):
                        if stopped.is_set():
                            break
                        on_data(_wrap(data))
                except Exception as e:
                    if on_error and not stopped.is_set():
                        on_error(e)

            asyncio.run(_run())

        thread = threading.Thread(target=_worker, daemon=True)
        thread.start()

        def unsubscribe() -> None:
            stopped.set()

        return unsubscribe

    def dispose(self) -> None:
        pass
<% } -%>
