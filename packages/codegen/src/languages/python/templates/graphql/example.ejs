<% const opType = it.opType ?? 'query'; -%>
<% const op = it.op; -%>
<% const opName = op?.name ?? it.opName ?? 'items'; -%>
<% const args = op?.args ?? it.args ?? []; -%>
<% const exVal = (a) => { if (['Int', 'Float', 'number', 'integer'].includes(a.type)) return '10'; if (['Boolean', 'boolean'].includes(a.type)) return 'True'; if (a.type === 'ID') return `"example_${a.name}"`; return '"value"'; }; -%>
<% const argsObj = args.length > 0 ? `{${args.map(a => `"${a.name}": ${exVal(a)}`).join(', ')}}` : '{}'; -%>
<% if (opType === 'query') { -%>
# Query <%= opName %>
result = gql.query(lambda q:
    q.<%= opName %>(<%= argsObj %>, lambda p:
        p.id().name()
    )
)
<% } else if (opType === 'mutation') { -%>
# Mutation <%= opName %>
result = gql.mutate(lambda m:
    m.<%= opName %>(<%= argsObj %>, lambda p:
        p.id().name()
    )
)
<% } else { -%>
import asyncio

# One-shot subscription (resolves on first event)
event = asyncio.run(gql.subscribe_once(lambda s:
    s.<%= opName %>(<%= argsObj %>, lambda p:
        p.id().name()
    )
))

# Continuous subscription
unsubscribe = gql.subscribe(
    lambda s: s.<%= opName %>(lambda p: p.id().name()),
    lambda data: print("Event:", data),
)
# Later: unsubscribe()
<% } -%>
