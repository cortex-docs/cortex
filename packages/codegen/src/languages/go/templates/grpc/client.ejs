// <%= it.clientClass %> is a unified gRPC client for all services.
type <%= it.clientClass %> struct {
	conns       map[string]*grpc.ClientConn
	baseURL    string
	httpClient *http.Client
}

// New<%= it.clientClass %> creates a new unified gRPC client.
func New<%= it.clientClass %>(opts ...ClientOption) (*<%= it.clientClass %>, error) {
	cfg := newClientConfig(opts)
	c := &<%= it.clientClass %>{
		conns:      make(map[string]*grpc.ClientConn),
		baseURL:    cfg.baseURL,
		httpClient: cfg.httpClient,
	}
	if cfg.baseURL != "" {
		return c, nil
	}
<% for (const service of it.services) { %>
	conn<%= service.name %>, err := grpc.NewClient(cfg.target, cfg.dialOpts...)
	if err != nil {
		c.Close()
		return nil, err
	}
	c.conns["<%= service.name %>"] = conn<%= service.name %>
<% } %>
	return c, nil
}

// Close closes all underlying gRPC connections.
func (c *<%= it.clientClass %>) Close() error {
	var lastErr error
	for _, conn := range c.conns {
		if conn != nil {
			if err := conn.Close(); err != nil {
				lastErr = err
			}
		}
	}
	return lastErr
}

<% for (const service of it.services) { %>
<% for (const method of service.methods) { %>
<% if (method.description) { %>// <%= it.naming.className(method.name) %> — <%= method.description %>
<% } else { %>// <%= it.naming.className(method.name) %> invokes the <%= method.name %> RPC.
<% } %>
<% if (!method.clientStreaming && !method.serverStreaming) { %>
func (c *<%= it.clientClass %>) <%= it.naming.className(method.name) %>(ctx context.Context, req *<%= method.inputType %>, callOpts ...grpc.CallOption) (*<%= method.outputType %>, error) {
	out := new(<%= method.outputType %>)
	if c.baseURL != "" {
		if err := postJSON(ctx, c.httpClient, c.baseURL, "<%= service.name %>", "<%= method.name %>", req, out); err != nil {
			return nil, err
		}
		return out, nil
	}
	err := c.conns["<%= service.name %>"].Invoke(ctx, "/<%= it.protoPackage %>.<%= service.name %>/<%= method.name %>", req, out, callOpts...)
	if err != nil {
		return nil, err
	}
	return out, nil
}

<% } else if (!method.clientStreaming && method.serverStreaming) { %>
func (c *<%= it.clientClass %>) <%= it.naming.className(method.name) %>(ctx context.Context, req *<%= method.inputType %>, callOpts ...grpc.CallOption) (<%= it.naming.className(method.name) %>Stream, error) {
	if c.baseURL != "" {
		var envelope struct {
			Data []<%= method.outputType %> `json:"data"`
		}
		if err := postJSON(ctx, c.httpClient, c.baseURL, "<%= service.name %>", "<%= method.name %>", req, &envelope); err != nil {
			return nil, err
		}
		return &httpServerStream[<%= method.outputType %>]{ctx: ctx, items: envelope.Data}, nil
	}
	streamDesc := &grpc.StreamDesc{ServerStreams: true}
	stream, err := c.conns["<%= service.name %>"].NewStream(ctx, streamDesc, "/<%= it.protoPackage %>.<%= service.name %>/<%= method.name %>", callOpts...)
	if err != nil {
		return nil, err
	}
	if err := stream.SendMsg(req); err != nil {
		return nil, err
	}
	if err := stream.CloseSend(); err != nil {
		return nil, err
	}
	return &<%= it.naming.className(method.name) %>ClientStream{ClientStream: stream}, nil
}

<% } else if (method.clientStreaming && !method.serverStreaming) { %>
func (c *<%= it.clientClass %>) <%= it.naming.className(method.name) %>(ctx context.Context, callOpts ...grpc.CallOption) (<%= it.naming.className(method.name) %>Stream, error) {
	streamDesc := &grpc.StreamDesc{ClientStreams: true}
	stream, err := c.conns["<%= service.name %>"].NewStream(ctx, streamDesc, "/<%= it.protoPackage %>.<%= service.name %>/<%= method.name %>", callOpts...)
	if err != nil {
		return nil, err
	}
	return stream, nil
}

<% } else { %>
func (c *<%= it.clientClass %>) <%= it.naming.className(method.name) %>(ctx context.Context, callOpts ...grpc.CallOption) (<%= it.naming.className(method.name) %>Stream, error) {
	streamDesc := &grpc.StreamDesc{ServerStreams: true, ClientStreams: true}
	stream, err := c.conns["<%= service.name %>"].NewStream(ctx, streamDesc, "/<%= it.protoPackage %>.<%= service.name %>/<%= method.name %>", callOpts...)
	if err != nil {
		return nil, err
	}
	return stream, nil
}

<% } %>
