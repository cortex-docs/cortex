// <%= it.naming.className(method.name) %>Stream is a server-streaming receiver for <%= method.name %>.
type <%= it.naming.className(method.name) %>Stream interface {
	Recv() (*<%= method.outputType %>, error)
	grpc.ClientStream
}

type <%= it.naming.className(method.name) %>ClientStream struct {
	grpc.ClientStream
}

func (s *<%= it.naming.className(method.name) %>ClientStream) Recv() (*<%= method.outputType %>, error) {
	out := new(<%= method.outputType %>)
	if err := s.ClientStream.RecvMsg(out); err != nil {
		return nil, err
	}
	return out, nil
}

<% } else if (method.clientStreaming && !method.serverStreaming) { %>
// <%= it.naming.className(method.name) %>Stream is a client-streaming sender for <%= method.name %>.
type <%= it.naming.className(method.name) %>Stream interface {
	Send(*<%= method.inputType %>) error
	CloseAndRecv() (*<%= method.outputType %>, error)
	grpc.ClientStream
}

<% } else if (method.clientStreaming && method.serverStreaming) { %>
// <%= it.naming.className(method.name) %>Stream is a bidirectional stream for <%= method.name %>.
type <%= it.naming.className(method.name) %>Stream interface {
	Send(*<%= method.inputType %>) error
	Recv() (*<%= method.outputType %>, error)
	grpc.ClientStream
}

<% } %>
<% } %>
