<% const pkgName = 'grpcclient'; %>
package <%= pkgName %>

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"strings"
	"time"

	"google.golang.org/grpc"
	"google.golang.org/grpc/credentials/insecure"
	"google.golang.org/grpc/metadata"
)

// ClientOption is a functional option for configuring gRPC clients.
type ClientOption func(*clientConfig)

type clientConfig struct {
	target     string
	baseURL    string
	dialOpts   []grpc.DialOption
	httpClient *http.Client
}

// WithTarget sets the gRPC server address.
func WithTarget(target string) ClientOption {
	return func(c *clientConfig) { c.target = target }
}

// WithBaseURL enables the HTTP-backed gRPC test transport.
func WithBaseURL(baseURL string) ClientOption {
	return func(c *clientConfig) { c.baseURL = baseURL }
}

// WithDialOptions sets additional gRPC dial options.
func WithDialOptions(opts ...grpc.DialOption) ClientOption {
	return func(c *clientConfig) { c.dialOpts = append(c.dialOpts, opts...) }
}

// WithHTTPClient sets the HTTP client used by the HTTP-backed transport.
func WithHTTPClient(httpClient *http.Client) ClientOption {
	return func(c *clientConfig) { c.httpClient = httpClient }
}

func newClientConfig(opts []ClientOption) clientConfig {
	cfg := clientConfig{
		target:     "localhost:50051",
		dialOpts:   []grpc.DialOption{grpc.WithTransportCredentials(insecure.NewCredentials())},
		httpClient: &http.Client{Timeout: 30 * time.Second},
	}
	for _, opt := range opts {
		opt(&cfg)
	}
	return cfg
}

func postJSON(ctx context.Context, client *http.Client, baseURL, service, method string, req interface{}, out interface{}) error {
	body, err := json.Marshal(req)
	if err != nil {
		return fmt.Errorf("marshal request: %w", err)
	}
	url := fmt.Sprintf("%s/grpc/%s/%s", strings.TrimRight(baseURL, "/"), service, method)
	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
	if err != nil {
		return fmt.Errorf("create request: %w", err)
	}
	httpReq.Header.Set("Content-Type", "application/json")

	resp, err := client.Do(httpReq)
	if err != nil {
		return fmt.Errorf("request failed: %w", err)
	}
	defer resp.Body.Close()

	if resp.StatusCode >= 400 {
		data, _ := io.ReadAll(resp.Body)
		return fmt.Errorf("grpc http error %d: %s", resp.StatusCode, string(data))
	}

	if out == nil {
		return nil
	}
	if err := json.NewDecoder(resp.Body).Decode(out); err != nil && err != io.EOF {
		return fmt.Errorf("decode response: %w", err)
	}
	return nil
}

type httpServerStream[T any] struct {
	ctx   context.Context
	items []T
	index int
}

func (s *httpServerStream[T]) Header() (metadata.MD, error) { return metadata.MD{}, nil }
func (s *httpServerStream[T]) Trailer() metadata.MD { return metadata.MD{} }
func (s *httpServerStream[T]) CloseSend() error { return nil }
func (s *httpServerStream[T]) Context() context.Context { return s.ctx }
func (s *httpServerStream[T]) SendMsg(m interface{}) error { return nil }
func (s *httpServerStream[T]) RecvMsg(m interface{}) error {
	next, err := s.Recv()
	if err != nil {
		return err
	}
	data, err := json.Marshal(next)
	if err != nil {
		return err
	}
	return json.Unmarshal(data, m)
}
func (s *httpServerStream[T]) Recv() (*T, error) {
	if s.index >= len(s.items) {
		return nil, io.EOF
	}
	item := &s.items[s.index]
	s.index++
	return item, nil
}

