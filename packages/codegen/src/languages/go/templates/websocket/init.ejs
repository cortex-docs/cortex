<% const _parts = (it.pkgName ?? it.config.languageConfig.package_name).split('/'); -%>
<% const pkgShort = _parts[_parts.length - 1].replace(/-/g, ''); -%>
<% const pkgFull = it.pkgName ?? it.config.languageConfig.package_name; -%>
<% const baseUrl = it.baseUrl ?? (it.spec.info.servers[0]?.url ?? 'http://localhost:3000'); -%>
<% const wsUrl = baseUrl.replace(/^http/, 'ws').replace(/\/v\d+$/, '') + '/ws'; -%>
import "<%= pkgFull %>"

ws := <%= pkgShort %>.New<%= it.clientClass %>("<%= wsUrl %>")