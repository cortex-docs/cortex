<% const opType = it.opType ?? 'query'; -%>
<% const op = it.op; -%>
<% const opName = op?.name ?? it.opName ?? 'items'; -%>
<% const args = op?.args ?? it.args ?? []; -%>
<% const opNamePascal = opName.charAt(0).toUpperCase() + opName.slice(1); -%>
<% const exVal = (a) => { if (['Int', 'Float', 'number', 'integer'].includes(a.type)) return '10'; if (['Boolean', 'boolean'].includes(a.type)) return 'true'; if (a.type === 'ID') return `ptr("example_${a.name}")`; return 'ptr("value")'; }; -%>
<% if (opType === 'query') { -%>
// Query <%= opName %>
result, err := gql.Query(func(q *gqlclient.QueryBuilder) *gqlclient.QueryBuilder {
	return q.<%= opNamePascal %>(
<% if (args.length > 0) { -%>
		&gqlclient.<%= opNamePascal %>Args{<%= args.map(a => `${a.name.charAt(0).toUpperCase() + a.name.slice(1)}: ${exVal(a)}`).join(', ') %>},
<% } else { -%>
		nil,
<% } -%>
		func(p *gqlclient.<%= opNamePascal %>Fields) *gqlclient.<%= opNamePascal %>Fields {
			return p.Id().Name()
		},
	)
})
<% } else if (opType === 'mutation') { -%>
// Mutation <%= opName %>
result, err := gql.Mutate(func(m *gqlclient.MutationBuilder) *gqlclient.MutationBuilder {
	return m.<%= opNamePascal %>(
<% if (args.length > 0) { -%>
		&gqlclient.<%= opNamePascal %>Args{<%= args.map(a => `${a.name.charAt(0).toUpperCase() + a.name.slice(1)}: ${exVal(a)}`).join(', ') %>},
<% } else { -%>
		nil,
<% } -%>
		func(p *gqlclient.<%= opNamePascal %>Fields) *gqlclient.<%= opNamePascal %>Fields {
			return p.Id().Name()
		},
	)
})
<% } else { -%>
// One-shot subscription (resolves on first event)
event, err := gql.SubscribeOnce(func(s *gqlclient.SubscriptionBuilder) *gqlclient.SubscriptionBuilder {
	return s.<%= opNamePascal %>(
<% if (args.length > 0) { -%>
		&gqlclient.<%= opNamePascal %>Args{<%= args.map(a => `${a.name.charAt(0).toUpperCase() + a.name.slice(1)}: ${exVal(a)}`).join(', ') %>},
<% } else { -%>
		nil,
<% } -%>
		func(p *gqlclient.<%= opNamePascal %>Fields) *gqlclient.<%= opNamePascal %>Fields {
			return p.Id().Name()
		},
	)
})

// Continuous subscription
unsubscribe, err := gql.Subscribe(
	func(s *gqlclient.SubscriptionBuilder) *gqlclient.SubscriptionBuilder {
		return s.<%= opNamePascal %>(
			nil,
			func(p *gqlclient.<%= opNamePascal %>Fields) *gqlclient.<%= opNamePascal %>Fields {
				return p.Id().Name()
			},
		)
	},
	func(data *gqlclient.SubscriptionResult) {
		fmt.Println("Event:", data)
	},
)
// Later: unsubscribe()
<% } -%>
