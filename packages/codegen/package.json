{
  "name": "@cortex-docs/codegen",
  "version": "0.1.6",
  "description": "SDK code generation engine for Cortex Docs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-docs/cortex.git",
    "directory": "packages/codegen"
  },
  "homepage": "https://github.com/cortex-docs/cortex#readme",
  "bugs": {
    "url": "https://github.com/cortex-docs/cortex/issues"
  },
  "keywords": [
    "cortex-docs",
    "openapi",
    "sdk",
    "code-generation"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "prepack": "npm run clean && npm run build",
    "copy-templates": "for dir in src/languages/*/templates; do lang=$(basename $(dirname $dir)); mkdir -p dist/languages/$lang && cp -r $dir dist/languages/$lang/; done",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cortex-docs/core": "0.1.6",
    "eta": "^4.6.0",
    "graphql": "^17.0.2",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
