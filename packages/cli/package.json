{
  "name": "@cortex/cli",
  "version": "0.1.1",
  "description": "Cortex Docs CLI for SDKs, API documentation, and MCP servers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cortex-docs/cortex.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/cortex-docs/cortex#readme",
  "bugs": {
    "url": "https://github.com/cortex-docs/cortex/issues"
  },
  "keywords": [
    "cortex-docs",
    "openapi",
    "sdk",
    "documentation",
    "mcp"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "cortex": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\"",
    "prepack": "npm run clean && npm run build",
    "dev": "tsc --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cortex/codegen": "0.1.1",
    "@cortex/core": "0.1.1",
    "@cortex/docs-ui": "0.1.1",
    "@cortex/mcp-gen": "0.1.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "chalk": "^5.4.0",
    "js-yaml": "^4.3.1",
    "nest-commander": "^3.20.0",
    "ora": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^22.0.0",
    "nest-commander-testing": "^3.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
